<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Academy | Town Crier</title>
  <meta name="description" content="<%= metaDescription %>" />
<link rel="canonical" href="<%= canonicalUrl %>" />
<% if (noindex) { %>
  <meta name="robots" content="noindex, nofollow" />
<% } %>
  <link rel="icon" type="image/png" href="/images/tcem-logo.png" />
  <link rel="apple-touch-icon" href="/images/tcem-logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="academy-page bg-[#f7f7f8] text-gray-900">

  <%- include("../partials/header") %>
  
  <%
  const viewerIsAdmin =
    typeof isAdmin !== "undefined" &&
    Boolean(isAdmin);

  function getAcademyMeta(academy) {
      const slug = (academy.slug || "").toLowerCase();
      const name = (academy.name || "").toLowerCase();

      if (slug === "dbw-hub" || slug === "dbw" || name.includes("dbw")) {
        return {
          title: academy.name || "DBW Hub",
          subtitle: "Discipleship by the Word",
          description:
            academy.shortDescription ||
            "Deepen your understanding of Scripture through structured study and community engagement.",
          button: "Enter DBW Hub"
        };
      }

      if (slug === "davidic-harp" || name.includes("davidic")) {
        return {
          title: academy.name || "DAVIDIC HARP",
          subtitle: "Worship and Music Discipleship",
          description:
            academy.shortDescription ||
            "Learn to lead worship and grow spiritually through music, song, and praise.",
          button: "Enter Davidic Harp"
        };
      }

      return {
        title: academy.name || "Academy",
        subtitle: "Ministry Learning Path",
        description:
          academy.shortDescription ||
          "Grow in truth, character, and ministry through guided spiritual formation.",
        button: `Enter ${academy.name || "Academy"}`
      };
    }
  %>

  <style>
    .academy-page {
      font-family: "Inter", sans-serif;
    }

    .academy-shell {
      padding-top: 4rem;
      padding-bottom: 5.5rem;
    }

    .academy-kicker {
      font-size: 0.82rem;
      line-height: 1;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #b3834d;
      margin-bottom: 1rem;
    }

    .academy-title {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(3rem, 5vw, 4.7rem);
      line-height: 0.95;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #1f2240;
      margin-bottom: 1rem;
    }
    .academy-title-accent {
  font-style: italic;
  color: #6B46C1;
}
    .academy-subtitle {
      max-width: 760px;
      margin: 0 auto;
      font-size: 1.05rem;
      line-height: 1.8;
      color: #475569;
    }

    .academy-grid {
      margin-top: 3rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .academy-card {
      position: relative;
      background: linear-gradient(180deg, rgba(255,255,255,0.96) 0%, rgba(250,247,255,0.92) 100%);
      border: 2px solid rgba(139, 92, 246, 0.28);
      border-radius: 2rem;
      padding: 2.25rem 2rem 1.8rem;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.05);
      transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
      overflow: hidden;
    }

    .academy-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top left, rgba(107, 70, 193, 0.08), transparent 45%);
      pointer-events: none;
    }

    .academy-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 24px 50px rgba(15, 23, 42, 0.08);
      border-color: rgba(107, 70, 193, 0.42);
    }

    .academy-card__content {
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .academy-card__title {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(2.2rem, 4vw, 3.4rem);
      line-height: 0.98;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #23253f;
      margin-bottom: 0.35rem;
    }

    .academy-card__subtitle {
      font-size: 1rem;
      line-height: 1.4;
      font-weight: 700;
      color: #5b2d91;
      margin-bottom: 1rem;
    }

    .academy-card__description {
      max-width: 460px;
      margin: 0 auto 1.35rem;
      font-size: 0.98rem;
      line-height: 1.75;
      color: #4b5563;
    }

    .academy-card__rule {
      width: 90px;
      height: 1px;
      background: rgba(31, 34, 64, 0.18);
      margin: 0 auto 1.4rem;
    }

    .academy-card__cta {
      display: inline-flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
      min-height: 3.4rem;
      border-radius: 0.9rem;
      background: #6B46C1;
      color: #ffffff;
      font-weight: 700;
      padding: 0.95rem 1.2rem;
      transition: background-color 180ms ease, transform 180ms ease;
    }

    .academy-card__cta:hover {
      background: #5b35b5;
      transform: translateY(-1px);
    }

    .academy-footnote {
      margin-top: 1.45rem;
      text-align: center;
      font-size: 0.98rem;
      color: #4b5563;
    }

    .academy-footnote a {
      color: #1f2937;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .academy-empty {
      background: #ffffff;
      border: 1px solid rgba(15, 23, 42, 0.08);
      border-radius: 2rem;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.05);
      padding: 3rem 1.5rem;
      text-align: center;
    }

    .academy-empty__title {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(2.2rem, 4vw, 3.1rem);
      line-height: 1;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #23253f;
      margin-bottom: 0.8rem;
    }

    .academy-empty__text {
      font-size: 1rem;
      line-height: 1.8;
      color: #64748b;
    }

    @media (min-width: 768px) {
      .academy-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
      }

      .academy-card {
        padding: 2.6rem 2rem 1.9rem;
      }
    }

    @media (max-width: 767px) {
      .academy-shell {
        padding-top: 3.25rem;
        padding-bottom: 4.5rem;
      }

      .academy-title {
        font-size: clamp(2.5rem, 12vw, 3.4rem);
      }

      .academy-subtitle {
        font-size: 1rem;
        line-height: 1.75;
      }

      .academy-card__title {
        font-size: 2.4rem;
      }

      .academy-card__description {
        font-size: 0.95rem;
      }
    }
    .academy-card--coming-soon {
  border-color: rgba(107, 70, 193, 0.2);
}

.academy-card--coming-soon:hover {
  transform: translateY(-3px);
}

.academy-card__cta--coming-soon {
  border: none;
  cursor: pointer;
}

.davidic-coming-soon-modal[hidden] {
  display: none;
}

.davidic-coming-soon-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
}

.davidic-coming-soon-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.72);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.davidic-coming-soon-modal__dialog {
  position: relative;
  z-index: 1;
  width: min(100%, 520px);
  background: #ffffff;
  border: 1px solid rgba(107, 70, 193, 0.14);
  border-radius: 2rem;
  box-shadow: 0 30px 80px rgba(15, 23, 42, 0.25);
  padding: 2.3rem;
  text-align: center;
}

.davidic-coming-soon-modal__close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  width: 42px;
  height: 42px;
  border: none;
  border-radius: 999px;
  background: #f1f5f9;
  color: #334155;
  font-size: 1.6rem;
  line-height: 1;
  cursor: pointer;
}

.davidic-coming-soon-modal__icon {
  width: 72px;
  height: 72px;
  margin: 0 auto 1.3rem;
  border-radius: 1.4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(107, 70, 193, 0.12);
  font-size: 2rem;
}

.davidic-coming-soon-modal__title {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(2.4rem, 6vw, 3.3rem);
  line-height: 0.98;
  font-weight: 700;
  letter-spacing: -0.025em;
  color: #1f2240;
  margin-bottom: 1rem;
}

.davidic-coming-soon-modal__text {
  color: #475569;
  font-size: 1rem;
  line-height: 1.8;
  margin-bottom: 1.7rem;
}

.davidic-coming-soon-modal__button {
  width: 100%;
  min-height: 3.3rem;
  border: none;
  border-radius: 1rem;
  background: #6b46c1;
  color: #ffffff;
  padding: 0.9rem 1.4rem;
  font-weight: 700;
  cursor: pointer;
  transition:
    background-color 180ms ease,
    transform 180ms ease;
}

.davidic-coming-soon-modal__button:hover {
  background: #5b35b5;
  transform: translateY(-1px);
}

/* =========================================================
   ACADEMY INDEX - DARK MODE
   =========================================================
   Covers:
   - Academy landing page
   - DBW Hub card
   - Davidic Harp Coming Soon card
   - Coming Soon modal

   Light mode remains unchanged.
   No glow effects.
   ========================================================= */


/* =========================================================
   PAGE CANVAS
   ========================================================= */

html[data-theme="dark"] body.academy-page {
  background: #0f0f18 !important;
  color: #d7d4df;
}


/* =========================================================
   PAGE INTRO
   ========================================================= */

html[data-theme="dark"] .academy-kicker {
  color: #d6a84b;
}

html[data-theme="dark"] .academy-title {
  color: #f8f7fb;
}

html[data-theme="dark"] .academy-title-accent {
  color: #8b5cf6;
}

html[data-theme="dark"] .academy-subtitle {
  color: #aaa6b4;
}


/* =========================================================
   ACADEMY CARDS
   ========================================================= */

html[data-theme="dark"] .academy-card {
  background: #191921;

  border-color:
    rgba(139, 92, 246, 0.28);

  box-shadow:
    0 14px 30px rgba(0, 0, 0, 0.20);
}


/*
 * Remove the light radial decoration.
 * This prevents the purple-glow appearance.
 */
html[data-theme="dark"] .academy-card::before {
  background: none;
}

html[data-theme="dark"] .academy-card:hover {
  transform: translateY(-4px);

  border-color:
    rgba(167, 139, 250, 0.38);

  box-shadow:
    0 18px 34px rgba(0, 0, 0, 0.26);
}


/* =========================================================
   CARD TYPOGRAPHY
   ========================================================= */

html[data-theme="dark"] .academy-card__title {
  color: #f8f7fb;
}

html[data-theme="dark"] .academy-card__subtitle {
  color: #a78bfa;
}

html[data-theme="dark"] .academy-card__description {
  color: #c9c6d1;
}

html[data-theme="dark"] .academy-card__rule {
  background:
    rgba(255, 255, 255, 0.12);
}


/* =========================================================
   CARD BUTTON
   ========================================================= */

html[data-theme="dark"] .academy-card__cta {
  background: #7044d4;

  color: #ffffff;

  border:
    1px solid rgba(167, 139, 250, 0.22);

  box-shadow: none;
}

html[data-theme="dark"] .academy-card__cta:hover {
  background: #7c4ce0;

  color: #ffffff;

  transform: translateY(-1px);

  box-shadow: none;
}


/* =========================================================
   DAVIDIC HARP COMING SOON CARD
   ========================================================= */

html[data-theme="dark"] .academy-card--coming-soon {
  border-color:
    rgba(139, 92, 246, 0.20);
}

html[data-theme="dark"] .academy-card--coming-soon:hover {
  border-color:
    rgba(167, 139, 250, 0.30);

  transform: translateY(-3px);
}

html[data-theme="dark"] .academy-card__cta--coming-soon {
  background: #7044d4;

  color: #ffffff;

  box-shadow: none;
}


/* =========================================================
   FOOTNOTE
   ========================================================= */

html[data-theme="dark"] .academy-footnote {
  color: #aaa6b4;
}

html[data-theme="dark"] .academy-footnote a {
  color: #d7d4df;
}

html[data-theme="dark"] .academy-footnote a:hover {
  color: #a78bfa;
}


/* =========================================================
   EMPTY ACADEMY STATE
   ========================================================= */

html[data-theme="dark"] .academy-empty {
  background: #191921;

  border-color:
    rgba(255, 255, 255, 0.08);

  box-shadow:
    0 14px 30px rgba(0, 0, 0, 0.18);
}

html[data-theme="dark"] .academy-empty__title {
  color: #f8f7fb;
}

html[data-theme="dark"] .academy-empty__text {
  color: #aaa6b4;
}


/* =========================================================
   DAVIDIC HARP MODAL BACKDROP
   ========================================================= */

html[data-theme="dark"]
.davidic-coming-soon-modal__backdrop {
  background:
    rgba(3, 3, 10, 0.82);
}


/* =========================================================
   DAVIDIC HARP MODAL
   ========================================================= */

html[data-theme="dark"]
.davidic-coming-soon-modal__dialog {
  background: #191921;

  border-color:
    rgba(139, 92, 246, 0.20);

  box-shadow:
    0 24px 60px rgba(0, 0, 0, 0.42);
}


/* Close button */

html[data-theme="dark"]
.davidic-coming-soon-modal__close {
  background: #25252f;

  color: #e7e4ed;
}

html[data-theme="dark"]
.davidic-coming-soon-modal__close:hover {
  background: #30303b;

  color: #ffffff;
}


/* Modal icon */

html[data-theme="dark"]
.davidic-coming-soon-modal__icon {
  background:
    rgba(139, 92, 246, 0.13);

  border:
    1px solid rgba(139, 92, 246, 0.18);
}


/* Modal title */

html[data-theme="dark"]
.davidic-coming-soon-modal__title {
  color: #f8f7fb;
}


/* Modal description */

html[data-theme="dark"]
.davidic-coming-soon-modal__text {
  color: #c9c6d1;
}


/* Modal button */

html[data-theme="dark"]
.davidic-coming-soon-modal__button {
  background: #7044d4;

  color: #ffffff;

  box-shadow: none;
}

html[data-theme="dark"]
.davidic-coming-soon-modal__button:hover {
  background: #7c4ce0;

  box-shadow: none;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 767px) {

  html[data-theme="dark"] .academy-card,
  html[data-theme="dark"] .academy-empty {
    box-shadow:
      0 10px 22px rgba(0, 0, 0, 0.18);
  }

  html[data-theme="dark"] .academy-card:hover {
    transform: none;

    box-shadow:
      0 10px 22px rgba(0, 0, 0, 0.18);
  }

  html[data-theme="dark"]
  .davidic-coming-soon-modal__dialog {
    box-shadow:
      0 20px 45px rgba(0, 0, 0, 0.38);
  }

}
  </style>

  <section class="academy-shell">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <div class="text-center">
        <p class="academy-kicker">Enter the Academy</p>
        <h1 class="academy-title">
             Choose Your <span class="academy-title-accent">Learning Path</span>
        </h1>
        <p class="academy-subtitle">
          Explore our Academy’s specialized pathways designed to deepen your understanding and walk with God.
        </p>
      </div>

      <% if (academies && academies.length) { %>
        <div class="academy-grid">
          <% academies.forEach((academy) => {
     const meta = getAcademyMeta(academy);

     const normalizedAcademySlug =
       String(academy.slug || "").toLowerCase();

     const isDavidicHarp =
       normalizedAcademySlug === "davidic-harp";

     const isDavidicHarpLocked =
       isDavidicHarp && !viewerIsAdmin;
%>
  <article
    class="academy-card <%= isDavidicHarpLocked ? 'academy-card--coming-soon' : '' %>"
  >
    <div class="academy-card__content">
      <h2 class="academy-card__title">
        <%= meta.title %>
      </h2>

      <p class="academy-card__subtitle">
        <%= meta.subtitle %>
      </p>

      <p class="academy-card__description">
        <%= meta.description %>
      </p>

      <div class="academy-card__rule"></div>

      <% if (isDavidicHarpLocked) { %>
        <button
          type="button"
          class="academy-card__cta academy-card__cta--coming-soon"
          data-davidic-harp-coming-soon
        >
          <span>Coming Soon</span>
          <span aria-hidden="true">⏳</span>
        </button>
      <% } else { %>
        <a
          href="/academy/<%= academy.slug %>"
          class="academy-card__cta"
        >
          <span><%= meta.button %></span>
          <span aria-hidden="true">→</span>
        </a>
      <% } %>
    </div>
  </article>
<% }) %>
        </div>

        <p class="academy-footnote">
          Not sure which to choose?
          <a href="/contact">Contact us.</a>
        </p>
      <% } else { %>
        <div class="academy-grid">
          <div class="md:col-span-2 academy-empty">
            <h2 class="academy-empty__title">No academies available yet</h2>
            <p class="academy-empty__text">
              Please add academies from the database or seed script.
            </p>
          </div>
        </div>
      <% } %>
    </div>
  </section>
 
<!-- Davidic Harp Coming Soon Popup -->
<div
  id="davidic-harp-coming-soon-modal"
  class="davidic-coming-soon-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="davidic-coming-soon-title"
  hidden
>
  <div
    class="davidic-coming-soon-modal__backdrop"
    data-davidic-coming-soon-close
  ></div>

  <div class="davidic-coming-soon-modal__dialog">
    <button
      type="button"
      class="davidic-coming-soon-modal__close"
      aria-label="Close Coming Soon message"
      data-davidic-coming-soon-close
    >
      ×
    </button>

    <div
      class="davidic-coming-soon-modal__icon"
      aria-hidden="true"
    >
      🎵
    </div>

    <h2
      id="davidic-coming-soon-title"
      class="davidic-coming-soon-modal__title"
    >
      Davidic Harp Is Coming Soon
    </h2>

    <p class="davidic-coming-soon-modal__text">
      The Davidic Harp Academy is currently being prepared.
      Its courses and learning materials will become available
      once the programme is ready.
    </p>

    <button
      type="button"
      class="davidic-coming-soon-modal__button"
      data-davidic-coming-soon-close
    >
      Return to the Academy
    </button>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const modal = document.getElementById(
      "davidic-harp-coming-soon-modal"
    );

    if (!modal) {
      return;
    }

    const openButtons = document.querySelectorAll(
      "[data-davidic-harp-coming-soon]"
    );

    const closeButtons = modal.querySelectorAll(
      "[data-davidic-coming-soon-close]"
    );

    const mainCloseButton = modal.querySelector(
      ".davidic-coming-soon-modal__close"
    );

    function openComingSoonModal() {
      modal.hidden = false;
      document.body.style.overflow = "hidden";

      if (mainCloseButton) {
        mainCloseButton.focus();
      }
    }

    function closeComingSoonModal() {
      modal.hidden = true;
      document.body.style.overflow = "";

      if (
        window.location.hash ===
        "#davidic-harp-coming-soon"
      ) {
        history.replaceState(
          null,
          "",
          window.location.pathname +
            window.location.search
        );
      }
    }

    openButtons.forEach(function (button) {
      button.addEventListener("click", function () {
        openComingSoonModal();
      });
    });

    closeButtons.forEach(function (button) {
      button.addEventListener("click", function () {
        closeComingSoonModal();
      });
    });

    document.addEventListener("keydown", function (event) {
      if (
        event.key === "Escape" &&
        !modal.hidden
      ) {
        closeComingSoonModal();
      }
    });

    if (
      window.location.hash ===
      "#davidic-harp-coming-soon"
    ) {
      openComingSoonModal();
    }
  });
</script>

  <%- include("../partials/footer") %>
</body>
</html>