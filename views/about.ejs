</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    const carousel =
      document.getElementById("about-video-carousel");

    if (!carousel) {
      return;
    }


    const slides =
      Array.from(
        carousel.querySelectorAll(".about-video-slide")
      );


    const dots =
      Array.from(
        document.querySelectorAll(".about-video-dot")
      );


    const iframes =
      Array.from(
        carousel.querySelectorAll(".about-video-iframe")
      );


    const total = slides.length;

    if (!total) {
      return;
    }


    /* =========================================
       STATE
       ========================================= */

    let activeIndex = 0;

    let autoPlay = null;

    let playbackMonitor = null;

    let apiFailureTimer = null;


    /*
     * IMPORTANT:
     *
     * The carousel is NOT permitted to
     * automatically move until the YouTube
     * players have successfully connected.
     */
    let automaticRotationEnabled = false;


    const youtubePlayers = [];

    const readyPlayers = new Set();

    const playingVideos = new Set();



    /* =========================================
       INDEX HELPERS
       ========================================= */

    function getWrappedIndex(index) {

      if (index < 0) {
        return total - 1;
      }


      if (index >= total) {
        return 0;
      }


      return index;
    }



    /* =========================================
       STOP AUTO ROTATION
       ========================================= */

    function stopAutoPlay() {

      if (autoPlay !== null) {

        clearInterval(autoPlay);

        autoPlay = null;

      }

    }



    /* =========================================
       READ THE REAL PLAYER STATES
       ========================================= */

    function syncPlaybackState() {

      if (
        !window.YT ||
        !window.YT.PlayerState
      ) {

        stopAutoPlay();

        return;
      }


      playingVideos.clear();


      youtubePlayers.forEach(
        function (player, index) {

          if (
            !player ||
            typeof player.getPlayerState !== "function"
          ) {

            return;

          }


          try {

            const state =
              player.getPlayerState();


            /*
             * Treat PLAYING and BUFFERING
             * as states where the carousel
             * must remain completely still.
             */
            if (
              state === window.YT.PlayerState.PLAYING ||
              state === window.YT.PlayerState.BUFFERING
            ) {

              playingVideos.add(index);

            }

          } catch (error) {

            /*
             * Player may not yet be fully ready.
             * Do nothing until next check.
             */

          }

        }
      );


      if (playingVideos.size > 0) {

        stopAutoPlay();

      } else if (
        automaticRotationEnabled &&
        autoPlay === null
      ) {

        startAutoPlay();

      }

    }



    /* =========================================
       START AUTO ROTATION
       ========================================= */

    function startAutoPlay() {

      /*
       * Fail-safe:
       *
       * Never auto-rotate unless YouTube API
       * integration has been confirmed.
       */
      if (!automaticRotationEnabled) {
        return;
      }


      /*
       * Never rotate while any video is
       * playing or buffering.
       */
      if (playingVideos.size > 0) {
        return;
      }


      /*
       * Don't create multiple timers.
       */
      if (autoPlay !== null) {
        return;
      }


      autoPlay =
        setInterval(
          function () {

            /*
             * Check the real player states
             * immediately before rotating.
             */
            syncPlaybackState();


            /*
             * A video may have started since
             * the previous timer cycle.
             */
            if (playingVideos.size > 0) {

              stopAutoPlay();

              return;

            }


            updateCarousel(
              activeIndex + 1,
              true
            );

          },
          5000
        );

    }



    /* =========================================
       PLAYBACK MONITOR
       ========================================= */

    function startPlaybackMonitor() {

      if (playbackMonitor !== null) {
        return;
      }


      /*
       * onStateChange should normally be
       * sufficient, but this monitor provides
       * a second layer of protection.
       *
       * Even if a PLAYING event is missed,
       * we inspect the actual player states.
       */
      playbackMonitor =
        setInterval(
          function () {

            syncPlaybackState();

          },
          700
        );

    }



    /* =========================================
       PAUSE VIDEOS ON OTHER SLIDES
       ========================================= */

    function pauseOtherVideos(indexToKeep) {

      youtubePlayers.forEach(
        function (player, index) {

          if (
            !player ||
            index === indexToKeep ||
            typeof player.pauseVideo !== "function"
          ) {

            return;

          }


          try {

            const state =
              player.getPlayerState();


            if (
              state === window.YT.PlayerState.PLAYING ||
              state === window.YT.PlayerState.BUFFERING
            ) {

              player.pauseVideo();

            }

          } catch (error) {

            console.warn(
              "Could not pause inactive YouTube player:",
              error
            );

          }

        }
      );

    }



    /* =========================================
       UPDATE CAROUSEL
       ========================================= */

    function updateCarousel(
      index,
      pauseInactiveVideos = false
    ) {

      activeIndex =
        getWrappedIndex(index);


      if (pauseInactiveVideos) {

        pauseOtherVideos(
          activeIndex
        );

      }


      const prevIndex =
        getWrappedIndex(
          activeIndex - 1
        );


      const nextIndex =
        getWrappedIndex(
          activeIndex + 1
        );


      slides.forEach(
        function (slide, i) {

          slide.classList.remove(
            "is-active",
            "is-prev",
            "is-next",
            "is-hidden-left",
            "is-hidden-right"
          );


          if (i === activeIndex) {

            slide.classList.add(
              "is-active"
            );

          } else if (
            window.innerWidth >= 768 &&
            i === prevIndex
          ) {

            slide.classList.add(
              "is-prev"
            );

          } else if (
            window.innerWidth >= 768 &&
            i === nextIndex
          ) {

            slide.classList.add(
              "is-next"
            );

          } else if (
            window.innerWidth >= 768
          ) {

            if (
              i < activeIndex &&
              !(
                activeIndex === 0 &&
                i === total - 1
              )
            ) {

              slide.classList.add(
                "is-hidden-left"
              );

            } else {

              slide.classList.add(
                "is-hidden-right"
              );

            }

          }

        }
      );


      dots.forEach(
        function (dot, i) {

          dot.classList.toggle(
            "is-active",
            i === activeIndex
          );

        }
      );

    }



    /* =========================================
       DOT NAVIGATION
       ========================================= */

    dots.forEach(
      function (dot) {

        dot.addEventListener(
          "click",
          function () {

            const index =
              Number(
                this.dataset.index
              );


            stopAutoPlay();


            updateCarousel(
              index,
              true
            );


            /*
             * Wait briefly for pauseVideo()
             * to update the YouTube state.
             */
            setTimeout(
              function () {

                syncPlaybackState();

              },
              150
            );

          }
        );

      }
    );



    /* =========================================
       RESIZE
       ========================================= */

    window.addEventListener(
      "resize",
      function () {

        /*
         * Only recalculate positions.
         * Do not alter video playback.
         */
        updateCarousel(
          activeIndex,
          false
        );

      }
    );



    /* =========================================
       YOUTUBE STATE CHANGE
       ========================================= */

    function handleYouTubeStateChange(
      event,
      videoIndex
    ) {

      if (
        !window.YT ||
        !window.YT.PlayerState
      ) {

        stopAutoPlay();

        return;

      }


      const state =
        event.data;


      /* -----------------------------------------
         PLAYING
         ----------------------------------------- */

      if (
        state ===
        window.YT.PlayerState.PLAYING
      ) {

        playingVideos.add(
          videoIndex
        );


        /*
         * THIS IS THE IMPORTANT BEHAVIOUR:
         *
         * As soon as playback begins,
         * completely kill the carousel timer.
         */
        stopAutoPlay();


        /*
         * If necessary, bring the playing
         * video back into the active position.
         */
        if (
          activeIndex !== videoIndex
        ) {

          updateCarousel(
            videoIndex,
            false
          );

        }


        return;
      }



      /* -----------------------------------------
         BUFFERING
         ----------------------------------------- */

      if (
        state ===
        window.YT.PlayerState.BUFFERING
      ) {

        playingVideos.add(
          videoIndex
        );


        stopAutoPlay();


        return;
      }



      /* -----------------------------------------
         PAUSED
         ----------------------------------------- */

      if (
        state ===
        window.YT.PlayerState.PAUSED
      ) {

        playingVideos.delete(
          videoIndex
        );


        setTimeout(
          function () {

            syncPlaybackState();

          },
          150
        );


        return;
      }



      /* -----------------------------------------
         ENDED
         ----------------------------------------- */

      if (
        state ===
        window.YT.PlayerState.ENDED
      ) {

        playingVideos.delete(
          videoIndex
        );


        setTimeout(
          function () {

            syncPlaybackState();

          },
          150
        );


        return;
      }



      /* -----------------------------------------
         CUED / UNSTARTED
         ----------------------------------------- */

      if (
        state ===
          window.YT.PlayerState.CUED ||
        state ===
          window.YT.PlayerState.UNSTARTED
      ) {

        playingVideos.delete(
          videoIndex
        );

      }

    }



    /* =========================================
       INITIALISE PLAYERS
       ========================================= */

    function initializeYouTubePlayers() {

      if (
        !window.YT ||
        !window.YT.Player
      ) {

        automaticRotationEnabled = false;

        stopAutoPlay();

        return;
      }


      if (apiFailureTimer !== null) {

        clearTimeout(
          apiFailureTimer
        );

        apiFailureTimer = null;

      }


      iframes.forEach(
        function (iframe, index) {

          if (youtubePlayers[index]) {
            return;
          }


          try {

            youtubePlayers[index] =
              new window.YT.Player(
                iframe.id,
                {

                  events: {

                    onReady:
                      function () {

                        readyPlayers.add(
                          index
                        );


                        console.log(
                          "About video ready:",
                          index
                        );


                        /*
                         * Only when ALL carousel
                         * players are connected do
                         * we permit automatic rotation.
                         */
                        if (
                          readyPlayers.size === total
                        ) {

                          console.log(
                            "All About-page YouTube players are ready."
                          );


                          automaticRotationEnabled =
                            true;


                          startPlaybackMonitor();


                          syncPlaybackState();

                        }

                      },


                    onStateChange:
                      function (event) {

                        console.log(
                          "About video state:",
                          index,
                          event.data
                        );


                        handleYouTubeStateChange(
                          event,
                          index
                        );

                      },


                    onError:
                      function (event) {

                        console.error(
                          "YouTube player error:",
                          index,
                          event.data
                        );


                        /*
                         * Safer to disable automatic
                         * movement than rotate a video
                         * unexpectedly.
                         */
                        automaticRotationEnabled =
                          false;


                        stopAutoPlay();

                      }

                  }

                }
              );

          } catch (error) {

            console.error(
              "Unable to initialise YouTube player:",
              error
            );


            automaticRotationEnabled =
              false;


            stopAutoPlay();

          }

        }
      );

    }



    /* =========================================
       LOAD YOUTUBE API
       ========================================= */

    function loadYouTubeAPI() {

      /*
       * API already loaded.
       */
      if (
        window.YT &&
        window.YT.Player
      ) {

        initializeYouTubePlayers();

        return;

      }


      /*
       * Keep existing callback if another
       * site component uses YouTube.
       */
      const previousCallback =
        window.onYouTubeIframeAPIReady;


      window.onYouTubeIframeAPIReady =
        function () {

          console.log(
            "YouTube IFrame API loaded successfully."
          );


          if (
            typeof previousCallback ===
            "function"
          ) {

            try {

              previousCallback();

            } catch (error) {

              console.warn(
                "Previous YouTube callback failed:",
                error
              );

            }

          }


          initializeYouTubePlayers();

        };


      const existingScript =
        document.querySelector(
          'script[src="https://www.youtube.com/iframe_api"]'
        );


      if (!existingScript) {

        const script =
          document.createElement(
            "script"
          );


        script.src =
          "https://www.youtube.com/iframe_api";


        script.async = true;


        script.onerror =
          function () {

            console.error(
              "The YouTube IFrame API script could not be loaded. Check Content Security Policy."
            );


            automaticRotationEnabled =
              false;


            stopAutoPlay();

          };


        document.head.appendChild(
          script
        );

      }


      /*
       * SAFETY TIMER
       *
       * If YouTube API has still not become
       * available after 8 seconds, leave
       * automatic carousel rotation DISABLED.
       *
       * This means a CSP failure can no longer
       * make a playing video rotate away.
       */
      apiFailureTimer =
        setTimeout(
          function () {

            if (
              !window.YT ||
              !window.YT.Player
            ) {

              console.error(
                "YouTube IFrame API did not initialise. Automatic video rotation has been disabled."
              );


              automaticRotationEnabled =
                false;


              stopAutoPlay();

            }

          },
          8000
        );

    }



    /* =========================================
       INITIAL PAGE STATE
       ========================================= */

    updateCarousel(
      0,
      false
    );


    /*
     * IMPORTANT:
     *
     * We deliberately DO NOT call
     * startAutoPlay() here anymore.
     *
     * The old script did this immediately:
     *
     *     startAutoPlay();
     *
     * That allowed the carousel to begin
     * spinning before YouTube integration
     * had necessarily finished.
     *
     * The new code waits until all players
     * confirm that they are ready.
     */
    loadYouTubeAPI();



    /* =========================================
       CLEANUP
       ========================================= */

    window.addEventListener(
      "beforeunload",
      function () {

        stopAutoPlay();


        if (
          playbackMonitor !== null
        ) {

          clearInterval(
            playbackMonitor
          );

        }


        if (
          apiFailureTimer !== null
        ) {

          clearTimeout(
            apiFailureTimer
          );

        }

      }
    );

  });
</script>
