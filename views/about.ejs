    border-color: rgba(255, 255, 255, 0.07) !important;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18) !important;
  }

  html[data-theme="dark"] .about-video-card {
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.2);
