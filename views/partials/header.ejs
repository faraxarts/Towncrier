<%
  const isConnectActive = ["/events", "/contact"].includes(currentPath);

  const isMinistriesActive = [
    "/ministries/dbw",
    "/ministries/bootcamp",
    "/ministries/arrows"
  ].includes(currentPath);

  const isLeadActive = [
    "/livingstone-akinadewo",
    "/ministry-lead"
  ].includes(currentPath);

  const isAboutActive = currentPath === "/about";
  const isHomeActive = currentPath === "/";

  const isAcademyActive =
    currentPath === "/academy" ||
    currentPath.startsWith("/academy/");
%>


<!-- =========================================
     TCEM THEME BOOTSTRAP

     Runs before the header is painted.

     Default = light mode.
     Dark mode only appears after the user
     explicitly chooses it.
     ========================================= -->
<script>
  (function () {
    try {
      const savedTheme =
        localStorage.getItem("tcem-theme");

      const initialTheme =
        savedTheme === "dark"
          ? "dark"
          : "light";

      document.documentElement.setAttribute(
        "data-theme",
        initialTheme
      );
    } catch (error) {
      document.documentElement.setAttribute(
        "data-theme",
        "light"
      );
    }
  })();
</script>


