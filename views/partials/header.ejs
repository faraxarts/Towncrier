      </details>



      <!-- MOBILE ACADEMY -->

      <a
        href="/academy"
        class="site-header__academy-btn mt-3 inline-flex w-full items-center justify-center rounded-full px-6 py-3 font-bold <%= isAcademyActive ? 'bg-white/10' : '' %>"
      >
        Academy
      </a>



      <% if (isLoggedIn && isAdmin) { %>

        <a
          href="/admin"
          class="site-header__academy-btn inline-flex w-full items-center justify-center rounded-full px-6 py-3 font-bold"
        >
          Admin
        </a>

      <% } %>



      <!-- =====================================
           MOBILE THEME TOGGLE
           ===================================== -->

      <div class="site-header__mobile-theme-row">

        <span class="site-header__mobile-theme-label">
          Appearance
        </span>


        <button
          type="button"
          id="mobile-theme-toggle"
          class="site-theme-toggle"
          aria-label="Switch to dark mode"
          title="Switch to dark mode"
        >

          <!-- SUN -->
          <svg
            class="site-theme-toggle__sun"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="3.5"
              stroke-width="1.5"
            />

            <path
              d="M12 2.75V5
                 M12 19V21.25
                 M21.25 12H19
                 M5 12H2.75
                 M18.54 5.46L16.95 7.05
                 M7.05 16.95L5.46 18.54
                 M18.54 18.54L16.95 16.95
                 M7.05 7.05L5.46 5.46"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>


          <!-- MOON -->
          <svg
            class="site-theme-toggle__moon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              d="M20.2 15.2A8.2 8.2 0 0 1 8.8 3.8
                 8.4 8.5 12.2 12.4 17 12.4
                 c1.1 0 2.2-.2 3.2-.6Z"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

        </button>

      </div>



      <% if (isLoggedIn) { %>

        <a
          href="/notifications"
          class="site-header__mobile-link inline-flex w-full items-center justify-between rounded-full px-6 py-3 font-bold"
        >

          <span>
            Notifications
          </span>


          <% if (unreadNotificationCount > 0) { %>

            <span
              class="min-w-[24px] h-[24px] px-1 inline-flex items-center justify-center rounded-full bg-red-500 text-white text-xs font-bold"
            >
              <%= unreadNotificationCount > 99
                ? "99+"
                : unreadNotificationCount %>
            </span>

          <% } %>

        </a>


        <button
          type="button"
          id="mobile-logout-btn"
          class="site-header__mobile-link inline-flex w-full items-center justify-center rounded-full px-6 py-3 font-bold"
        >
          Logout
        </button>

      <% } %>

    </nav>

  </div>

</header>



<script>
  document.addEventListener(
    "DOMContentLoaded",
    function () {

      /* =========================================
         MOBILE MENU
         ========================================= */

      const button =
        document.getElementById(
          "mobile-menu-button"
        );


      const menu =
        document.getElementById(
          "mobile-menu"
        );


      const openIcon =
        document.getElementById(
          "menu-open-icon"
        );


      const closeIcon =
        document.getElementById(
          "menu-close-icon"
        );


      const desktopLogoutBtn =
        document.getElementById(
          "desktop-logout-btn"
        );


      const mobileLogoutBtn =
        document.getElementById(
          "mobile-logout-btn"
        );


      const desktopThemeToggle =
        document.getElementById(
          "desktop-theme-toggle"
        );


      const mobileThemeToggle =
        document.getElementById(
          "mobile-theme-toggle"
        );


      const themeButtons =
        [
          desktopThemeToggle,
          mobileThemeToggle
        ].filter(Boolean);



      function openMenu() {

        if (
          !menu ||
          !openIcon ||
          !closeIcon ||
          !button
        ) {
          return;
        }


        menu.classList.remove(
          "hidden"
        );


        openIcon.classList.add(
          "hidden"
        );


        closeIcon.classList.remove(
          "hidden"
        );


        button.setAttribute(
          "aria-expanded",
          "true"
        );


        button.setAttribute(
          "aria-label",
          "Close navigation menu"
        );

      }



      function closeMenu() {

        if (
          !menu ||
          !openIcon ||
          !closeIcon ||
          !button
        ) {
          return;
        }


        menu.classList.add(
          "hidden"
        );


        openIcon.classList.remove(
          "hidden"
        );


        closeIcon.classList.add(
          "hidden"
        );


        button.setAttribute(
          "aria-expanded",
          "false"
        );


        button.setAttribute(
          "aria-label",
          "Open navigation menu"
        );

      }



      if (
        button &&
        menu &&
        openIcon &&
        closeIcon
      ) {

        button.addEventListener(
          "click",
          function () {

            if (
              menu.classList.contains(
                "hidden"
              )
            ) {

              openMenu();

            } else {

              closeMenu();

            }

          }
        );


        document.addEventListener(
          "click",
          function (event) {

            const clickedInsideMenu =
              menu.contains(
                event.target
              );


            const clickedButton =
              button.contains(
                event.target
              );


            if (
              !menu.classList.contains(
                "hidden"
              ) &&
              !clickedInsideMenu &&
              !clickedButton
            ) {

              closeMenu();

            }

          }
        );


        document.addEventListener(
          "keydown",
          function (event) {

            if (
              event.key === "Escape" &&
              !menu.classList.contains(
                "hidden"
              )
            ) {

              closeMenu();

              button.focus();

            }

          }
        );


        window.addEventListener(
          "resize",
          function () {

            if (
              window.innerWidth >= 1024
            ) {

              closeMenu();

            }

          }
        );

      }



      /* =========================================
         THEME SYSTEM
         ========================================= */

      function getCurrentTheme() {

        return (
          document.documentElement
            .getAttribute(
              "data-theme"
            ) === "dark"
        )
          ? "dark"
          : "light";

      }



      function updateThemeButtonLabels() {

        const currentTheme =
          getCurrentTheme();


        const targetTheme =
          currentTheme === "dark"
            ? "light"
            : "dark";


        themeButtons.forEach(
          function (themeButton) {

            themeButton.setAttribute(
              "aria-label",
              `Switch to ${targetTheme} mode`
            );


            themeButton.setAttribute(
              "title",
              `Switch to ${targetTheme} mode`
            );

          }
        );

      }



      function applyTheme(
        theme,
        savePreference = true
      ) {

        const safeTheme =
          theme === "dark"
            ? "dark"
            : "light";


        document.documentElement
          .setAttribute(
            "data-theme",
            safeTheme
          );


        if (savePreference) {

          try {

            localStorage.setItem(
              "tcem-theme",
              safeTheme
            );

          } catch (error) {

            console.warn(
              "Could not save theme preference:",
              error
            );

          }

        }


        updateThemeButtonLabels();


        /*
         * Other site components can listen
         * for this event later.
         */
        document.dispatchEvent(
          new CustomEvent(
            "tcem:themechange",
            {
              detail: {
                theme: safeTheme
              }
            }
          )
        );

      }



      themeButtons.forEach(
        function (themeButton) {

          themeButton.addEventListener(
            "click",
            function () {

              const currentTheme =
                getCurrentTheme();


              const nextTheme =
                currentTheme === "dark"
                  ? "light"
                  : "dark";


              applyTheme(
                nextTheme,
                true
              );

            }
          );

        }
      );


      updateThemeButtonLabels();



      /*
       * Synchronise theme if another browser
       * tab changes the saved preference.
       */
      window.addEventListener(
        "storage",
        function (event) {

          if (
            event.key !== "tcem-theme"
          ) {
            return;
          }


          applyTheme(
            event.newValue === "dark"
              ? "dark"
              : "light",
            false
          );

        }
      );



      /* =========================================
         LOGOUT
         ========================================= */

      async function handleLogout() {

        try {

          const response =
            await fetch(
              "/auth/logout",
              {
                method: "POST",

                headers: {
                  "Content-Type":
                    "application/json"
                },

                credentials:
                  "same-origin"
              }
            );


          const data =
            await response.json();


          if (!response.ok) {

            alert(
              data.message ||
              "Logout failed."
            );

            return;

          }


          window.location.href = "/";

        } catch (error) {

          console.error(
            "Logout error:",
            error
          );


          alert(
            "Something went wrong while logging out."
          );

        }

      }



      if (desktopLogoutBtn) {

        desktopLogoutBtn.addEventListener(
          "click",
          handleLogout
        );

      }


      if (mobileLogoutBtn) {

        mobileLogoutBtn.addEventListener(
          "click",
          handleLogout
        );

      }

    }
  );
</script>