<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : "Server Error" %> | Town Crier</title>
  <meta name="description" content="<%= metaDescription %>" />
<link rel="canonical" href="<%= canonicalUrl %>" />
<% if (noindex) { %>
  <meta name="robots" content="noindex" />
<% } %>
  <link rel="icon" type="image/png" href="/images/tcem-logo.png" />
  <link rel="apple-touch-icon" href="/images/tcem-logo.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css" />

  <style>
    .error-page {
      background: #f7f7f8;
      color: #111827;
      font-family: "Inter", sans-serif;
    }

    .error-kicker {
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #6B46C1;
      margin-bottom: 1rem;
    }

    .error-title {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(2.8rem, 6vw, 5rem);
      line-height: 0.94;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #111827;
      margin-bottom: 1.1rem;
    }

    .error-text {
      font-size: 1.05rem;
      line-height: 1.85;
      color: #64748b;
    }

    @media (max-width: 767px) {
      .error-title {
        font-size: clamp(2.3rem, 10vw, 3.4rem);
      }

      .error-text {
        font-size: 1rem;
        line-height: 1.75;
      }
    }
    /* =========================================================
   404 + 500 ERROR PAGES - DARK MODE
   =========================================================
   Light mode remains unchanged.
   No glow effects.
   ========================================================= */


/* =========================================================
   1. PAGE CANVAS
   ========================================================= */

html[data-theme="dark"] body.error-page {
  background: #0f0f18 !important;
  color: #d7d4df;
}


/* =========================================================
   2. ERROR CARD
   ========================================================= */

html[data-theme="dark"]
.error-page
.bg-white.border.border-gray-100 {
  background: #191921 !important;

  border-color:
    rgba(255, 255, 255, 0.08) !important;

  box-shadow:
    0 14px 30px rgba(0, 0, 0, 0.20) !important;
}


/* =========================================================
   3. ERROR KICKER
   ========================================================= */

html[data-theme="dark"]
.error-page
.error-kicker {
  color: #a78bfa;
}


/* =========================================================
   4. ERROR TITLE
   ========================================================= */

html[data-theme="dark"]
.error-page
.error-title {
  color: #f8f7fb;
}


/* =========================================================
   5. ERROR DESCRIPTION
   ========================================================= */

html[data-theme="dark"]
.error-page
.error-text {
  color: #aaa6b4;
}


/* =========================================================
   6. PRIMARY PURPLE BUTTON
   Go Home / Return Home
   ========================================================= */

html[data-theme="dark"]
.error-page
a.bg-\[\#6B46C1\] {
  background: #7044d4 !important;

  color: #ffffff !important;

  border:
    1px solid rgba(167, 139, 250, 0.22);

  box-shadow: none !important;
}


html[data-theme="dark"]
.error-page
a.bg-\[\#6B46C1\]:hover {
  background: #7c4ce0 !important;

  color: #ffffff !important;

  box-shadow: none !important;
}


/* =========================================================
   7. SECONDARY BUTTON
   Contact Us / Try Again
   ========================================================= */

html[data-theme="dark"]
.error-page
a.bg-white.border-gray-200,

html[data-theme="dark"]
.error-page
button.bg-white.border-gray-200 {
  background: #20202a !important;

  color: #d7d4df !important;

  border-color:
    rgba(255, 255, 255, 0.10) !important;

  box-shadow: none !important;
}


html[data-theme="dark"]
.error-page
a.bg-white.border-gray-200:hover,

html[data-theme="dark"]
.error-page
button.bg-white.border-gray-200:hover {
  background:
    rgba(139, 92, 246, 0.10) !important;

  color: #c4b5fd !important;

  border-color:
    #8b5cf6 !important;

  box-shadow: none !important;
}


/* =========================================================
   8. ACCESSIBLE FOCUS STATES
   ========================================================= */

html[data-theme="dark"]
.error-page
a:focus-visible,

html[data-theme="dark"]
.error-page
button:focus-visible {
  outline:
    2px solid #a78bfa;

  outline-offset: 3px;
}


/* =========================================================
   9. REMOVE LIGHT SHADOW / GLOW
   ========================================================= */

html[data-theme="dark"]
.error-page
.shadow,

html[data-theme="dark"]
.error-page
.shadow-sm,

html[data-theme="dark"]
.error-page
.shadow-md {
  box-shadow:
    0 14px 30px rgba(0, 0, 0, 0.20) !important;
}


/* Buttons stay flat */

html[data-theme="dark"]
.error-page
a.shadow-sm,

html[data-theme="dark"]
.error-page
button.shadow-sm {
  box-shadow: none !important;
}


/* =========================================================
   10. MOBILE
   ========================================================= */

@media (max-width: 767px) {

  html[data-theme="dark"]
  .error-page
  .bg-white.border.border-gray-100 {
    box-shadow:
      0 10px 22px rgba(0, 0, 0, 0.18) !important;
  }

}
  </style>
</head>
<body class="error-page">
  <%- include("partials/header") %>

  <section class="py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-6 md:px-16 text-center">
      <div class="bg-white border border-gray-100 rounded-[30px] shadow-sm p-10 md:p-14">
        <p class="error-kicker">Server Error</p>

        <h1 class="error-title">
          Something went wrong
        </h1>

        <p class="error-text mb-8">
          <%= typeof message !== 'undefined' && message ? message : "We hit an unexpected issue while loading this page. Please try again in a moment." %>
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/" class="inline-flex items-center justify-center rounded-2xl bg-[#6B46C1] text-white px-6 py-3 font-semibold hover:bg-purple-700 transition">
            Return Home
          </a>
          <button onclick="window.location.reload()" class="inline-flex items-center justify-center rounded-2xl border border-gray-200 bg-white px-6 py-3 font-semibold text-gray-800 hover:border-[#6B46C1] hover:text-[#6B46C1] transition">
            Try Again
          </button>
        </div>
      </div>
    </div>
  </section>

  <%- include("partials/footer") %>
</body>
</html>