<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Arrows in the Quiver | Town Crier
  </title>

  <meta
    name="description"
    content="<%= metaDescription %>"
  />

  <link
    rel="canonical"
    href="<%= canonicalUrl %>"
  />

  <% if (noindex) { %>
    <meta
      name="robots"
      content="noindex"
    />
  <% } %>

  <link
    rel="icon"
    type="image/png"
    href="/images/tcem-logo.png"
  />

  <link
    rel="apple-touch-icon"
    href="/images/tcem-logo.png"
  />

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="/css/style.css"
  />

  <style>
    .arrows-page {
      background: #f7f7f8;
      color: #111827;
      font-family: "Inter", sans-serif;
    }

    .arrows-subnav-link {
      font-family: "Inter", sans-serif;
    }

    .arrows-hero-title {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(3.2rem, 6vw, 5.6rem);
      line-height: 0.92;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
    }

    .arrows-hero-subtitle {
      font-family: "Inter", sans-serif;
      font-size: clamp(1.05rem, 2vw, 1.4rem);
      line-height: 1.45;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.96);
      margin-bottom: 1.1rem;
    }

    .arrows-hero-text {
      font-family: "Inter", sans-serif;
      font-size: clamp(1.05rem, 2vw, 1.4rem);
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.96);
    }

    .arrows-hero-quote {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(1.45rem, 2.8vw, 2.2rem);
      line-height: 1.2;
      font-style: italic;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.98);
    }

    .arrows-section-title {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(2.5rem, 4vw, 4rem);
      line-height: 0.96;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #111827;
    }

    .arrows-section-title--light {
      color: #ffffff !important;
    }

    .arrows-card-title {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(2rem, 3vw, 2.7rem);
      line-height: 1;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #111827;
    }

    .arrows-card-title--center {
      text-align: center;
    }

    .arrows-body-text {
      font-family: "Inter", sans-serif;
      font-size: 1.05rem;
      line-height: 1.85;
      color: #475569;
    }

    .arrows-meta-text {
      font-family: "Inter", sans-serif;
      font-size: 1rem;
      line-height: 1.7;
      color: #111827;
    }

    .arrows-list-text {
      font-family: "Inter", sans-serif;
      font-size: 1.05rem;
      line-height: 1.75;
      color: #111827;
    }

    .arrows-button-text {
      font-family: "Inter", sans-serif;
      font-weight: 700;
      letter-spacing: 0.01em;
    }


    /*
     * AGE GROUP IMAGE CARDS
     */
    .arrows-program-card {
      position: relative;
      isolation: isolate;
      min-height: 480px;
      overflow: hidden;

      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;

      box-shadow:
        0 18px 42px rgba(15, 23, 42, 0.1);

      transition:
        transform 250ms ease,
        box-shadow 250ms ease;
    }

    .arrows-program-card:hover {
      transform: translateY(-5px);

      box-shadow:
        0 26px 55px rgba(15, 23, 42, 0.14);
    }

    /*
     * Whitish layer over the photograph.
     *
     * Reduce 0.84 to something like 0.75 if you
     * later want the photograph to appear stronger.
     */
    .arrows-program-card::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;

      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.80) 0%,
          rgba(255, 255, 255, 0.86) 45%,
          rgba(255, 255, 255, 0.92) 100%
        );
    }

    /*
     * Small additional gradient gives the text
     * consistent readability on different photographs.
     */
    .arrows-program-card::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;

      background:
        linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.12),
          rgba(255, 255, 255, 0)
        );
    }

    .arrows-program-card__content {
      position: relative;
      z-index: 1;
      height: 100%;
    }

    .arrows-program-card .arrows-card-title {
      color: #111827;
    }

    .arrows-program-card .arrows-meta-text {
      color: #1f2937;
      font-weight: 600;
    }

    .arrows-program-card .arrows-list-text {
      color: #111827;
      font-weight: 500;
    }

    .arrows-program-card__emoji {
      width: 72px;
      height: 72px;
      margin: 0 auto 1.5rem;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 24px;

      background: rgba(255, 255, 255, 0.78);

      border:
        1px solid rgba(255, 255, 255, 0.75);

      box-shadow:
        0 8px 25px rgba(15, 23, 42, 0.08);

      font-size: 2.5rem;

      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
    }


    @media (max-width: 767px) {
      .arrows-hero-title {
        font-size: clamp(2.7rem, 12vw, 4rem);
      }

      .arrows-hero-subtitle,
      .arrows-hero-text,
      .arrows-body-text,
      .arrows-list-text {
        font-size: 1rem;
        line-height: 1.75;
      }

      .arrows-hero-quote {
        font-size: 1.4rem;
      }

      .arrows-program-card {
        min-height: 440px;
      }
    }
  </style>
</head>


