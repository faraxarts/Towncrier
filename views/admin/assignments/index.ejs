<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Assignment Review | Admin
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  />

</head>


<body
  class="bg-[#f7f7f8] text-gray-900"
>


  <div
    class="min-h-screen lg:grid lg:grid-cols-[280px_1fr]"
  >


    <%- include("../partials/admin-sidebar") %>


    <main
      class="px-6 py-8 md:px-10 lg:px-12"
    >


      <div
        class="max-w-7xl mx-auto"
      >


        <!-- =================================================
             HEADER
             ================================================= -->

        <div
          class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-8"
        >

          <div>

            <p
              class="text-sm font-bold uppercase tracking-widest text-[#6B46C1] mb-2"
            >
              DBW Hub
            </p>

            <h1
              class="text-4xl font-extrabold text-gray-950 mb-2"
            >
              Assignment Review
            </h1>

            <p
              class="text-lg text-slate-600"
            >
              Review learner submissions, provide feedback,
              accept completed work, or request revision.
            </p>

          </div>


          <a
            href="/admin"
            class="rounded-2xl bg-white border border-gray-200 px-5 py-3 font-semibold text-gray-800"
          >
            Back to Dashboard
          </a>

        </div>


        <!-- =================================================
             MESSAGES
             ================================================= -->

        <% if (success === "accepted") { %>

          <div
            class="mb-6 rounded-2xl border border-green-200 bg-green-50 p-5 text-green-700 font-semibold"
          >
            Assignment accepted successfully.
          </div>

        <% } %>


        <% if (success === "revision-requested") { %>

          <div
            class="mb-6 rounded-2xl border border-orange-200 bg-orange-50 p-5 text-orange-700 font-semibold"
          >
            Revision request sent successfully.
          </div>

        <% } %>


        <% if (error) { %>

          <div
            class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-5 text-red-700 font-semibold"
          >
            <%= error %>
          </div>

        <% } %>


        <!-- =================================================
             SUMMARY
             ================================================= -->

        <div
          class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8"
        >

          <a
            href="/admin/assignments<%= selectedAcademy ? `?academy=${selectedAcademy}` : '' %>"
            class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm"
          >

            <p
              class="text-sm text-slate-500 font-semibold mb-1"
            >
              All
            </p>

            <p
              class="text-3xl font-extrabold text-gray-950"
            >
              <%= counts.all %>
            </p>

          </a>


          <a
            href="/admin/assignments?status=Submitted<%= selectedAcademy ? `&academy=${selectedAcademy}` : '' %>"
            class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm"
          >

            <p
              class="text-sm text-slate-500 font-semibold mb-1"
            >
              Awaiting Review
            </p>

            <p
              class="text-3xl font-extrabold text-blue-700"
            >
              <%= counts.awaiting %>
            </p>

          </a>


          <a
            href="/admin/assignments?status=Needs%20Revision<%= selectedAcademy ? `&academy=${selectedAcademy}` : '' %>"
            class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm"
          >

            <p
              class="text-sm text-slate-500 font-semibold mb-1"
            >
              Needs Revision
            </p>

            <p
              class="text-3xl font-extrabold text-orange-700"
            >
              <%= counts.revision %>
            </p>

          </a>


          <a
            href="/admin/assignments?status=Accepted<%= selectedAcademy ? `&academy=${selectedAcademy}` : '' %>"
            class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm"
          >

            <p
              class="text-sm text-slate-500 font-semibold mb-1"
            >
              Accepted
            </p>

            <p
              class="text-3xl font-extrabold text-green-700"
            >
              <%= counts.accepted %>
            </p>

          </a>

        </div>


        <!-- =================================================
             FILTERS
             ================================================= -->

        <form
          method="GET"
          action="/admin/assignments"
          class="bg-white border border-gray-100 rounded-[24px] shadow-sm p-5 md:p-6 mb-8"
        >

          <div
            class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-[1fr_1fr_auto] gap-4 items-end"
          >


            <div>

              <label
                class="block text-sm font-semibold mb-2"
              >
                Academy
              </label>

              <select
                name="academy"
                class="w-full rounded-2xl border border-gray-200 px-4 py-3.5"
              >

                <option value="">
                  All Academies
                </option>


                <% academies.forEach((academy) => { %>

                  <option
                    value="<%= academy._id %>"
                    <%= String(selectedAcademy) === String(academy._id)
                      ? "selected"
                      : "" %>
                  >
                    <%= academy.name %>
                  </option>

                <% }) %>

              </select>

            </div>


            <div>

              <label
                class="block text-sm font-semibold mb-2"
              >
                Status
              </label>

              <select
                name="status"
                class="w-full rounded-2xl border border-gray-200 px-4 py-3.5"
              >

                <option value="">
                  All Statuses
                </option>

                <option
                  value="Submitted"
                  <%= selectedStatus === "Submitted"
                    ? "selected"
                    : "" %>
                >
                  Awaiting Review
                </option>

                <option
                  value="Needs Revision"
                  <%= selectedStatus === "Needs Revision"
                    ? "selected"
                    : "" %>
                >
                  Needs Revision
                </option>

                <option
                  value="Accepted"
                  <%= selectedStatus === "Accepted"
                    ? "selected"
                    : "" %>
                >
                  Accepted
                </option>

              </select>

            </div>


            <div
              class="flex gap-3"
            >

              <button
                type="submit"
                class="rounded-2xl bg-[#6B46C1] text-white px-5 py-3.5 font-semibold hover:bg-purple-700 transition"
              >
                Apply
              </button>


              <a
                href="/admin/assignments"
                class="rounded-2xl bg-white border border-gray-200 px-5 py-3.5 font-semibold text-gray-800"
              >
                Clear
              </a>

            </div>

          </div>

        </form>


        <!-- =================================================
             SUBMISSIONS
             ================================================= -->

        <% if (!submissions.length) { %>

          <div
            class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-12 text-center"
          >

            <h2
              class="text-2xl font-extrabold text-gray-950 mb-2"
            >
              No assignment submissions found
            </h2>

            <p
              class="text-slate-600"
            >
              Submissions matching these filters will appear here.
            </p>

          </div>

        <% } %>


        <div
          class="space-y-6"
        >

          <% submissions.forEach((item) => {

            const isAwaiting =
              item.status === "Submitted" ||
              item.status === "Reviewed";

            const isRevision =
              item.status === "Needs Revision";

            const isAccepted =
              item.status === "Accepted";

            const assignmentName =
              item.resource?.title ||
              item.assignmentTitle;
          %>


            <article
              class="bg-white border border-gray-100 rounded-[28px] shadow-sm overflow-hidden"
            >


              <!-- HEADER -->

              <div
                class="p-7 md:p-8 border-b border-gray-100"
              >

                <div
                  class="flex flex-col xl:flex-row xl:items-start xl:justify-between gap-5"
                >

                  <div>

                    <div
                      class="flex flex-wrap items-center gap-2 mb-3"
                    >

                      <% if (isAwaiting) { %>

                        <span
                          class="rounded-full bg-blue-100 text-blue-700 px-3 py-1 text-sm font-bold"
                        >
                          Awaiting Review
                        </span>

                      <% } %>


                      <% if (isRevision) { %>

                        <span
                          class="rounded-full bg-orange-100 text-orange-700 px-3 py-1 text-sm font-bold"
                        >
                          Needs Revision
                        </span>

                      <% } %>


                      <% if (isAccepted) { %>

                        <span
                          class="rounded-full bg-green-100 text-green-700 px-3 py-1 text-sm font-bold"
                        >
                          Accepted
                        </span>

                      <% } %>


                      <% if (item.resource) { %>

                        <span
                          class="rounded-full bg-purple-50 text-[#6B46C1] px-3 py-1 text-sm font-bold"
                        >
                          DBW V2
                        </span>

                      <% } else { %>

                        <span
                          class="rounded-full bg-gray-100 text-gray-600 px-3 py-1 text-sm font-bold"
                        >
                          Legacy
                        </span>

                      <% } %>

                    </div>


                    <h2
                      class="text-2xl md:text-3xl font-extrabold text-gray-950"
                    >
                      <%= assignmentName %>
                    </h2>


                    <p
                      class="text-slate-500 mt-2"
                    >
                      Submitted
                      <%= new Date(item.updatedAt || item.createdAt).toLocaleString() %>
                    </p>

                  </div>


                  <% if (
                    item.file &&
                    item.file.fileUrl
                  ) { %>

                    <a
                      href="<%= item.file.fileUrl %>"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-2xl bg-[#6B46C1] text-white px-5 py-3 font-semibold hover:bg-purple-700 transition text-center"
                    >
                      Open Submission
                    </a>

                  <% } %>

                </div>

              </div>


              <!-- DETAILS -->

              <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-6 p-7 md:p-8"
              >


                <div
                  class="space-y-3"
                >

                  <h3
                    class="font-extrabold text-gray-950 text-lg"
                  >
                    Learner
                  </h3>


                  <p class="text-slate-700">

                    <strong>
                      Name:
                    </strong>

                    <%= item.user?.name || "Unknown User" %>

                  </p>


                  <p class="text-slate-700">

                    <strong>
                      Email:
                    </strong>

                    <%= item.user?.email || "N/A" %>

                  </p>


                  <% if (item.submissionNote) { %>

                    <div
                      class="pt-2"
                    >

                      <strong
                        class="text-gray-900"
                      >
                        Submission Note
                      </strong>

                      <p
                        class="text-slate-600 mt-1 whitespace-pre-line"
                      >
                        <%= item.submissionNote %>
                      </p>

                    </div>

                  <% } %>

                </div>


                <div
                  class="space-y-3"
                >

                  <h3
                    class="font-extrabold text-gray-950 text-lg"
                  >
                    Course
                  </h3>


                  <p class="text-slate-700">

                    <strong>
                      Academy:
                    </strong>

                    <%= item.course?.academy?.name || "N/A" %>

                  </p>


                  <% if (item.course?.level) { %>

                    <p class="text-slate-700">

                      <strong>
                        Level:
                      </strong>

                      <%= item.course.level.title ||
                          item.course.level.name ||
                          "N/A" %>

                    </p>

                  <% } %>


                  <p class="text-slate-700">

                    <strong>
                      Course:
                    </strong>

                    <%= item.course?.title || "Unknown Course" %>

                  </p>


                  <p class="text-slate-700">

                    <strong>
                      Revision uploads:
                    </strong>

                    <%= item.revisionCount || 0 %>

                  </p>

                </div>

              </div>


              <!-- CURRENT FEEDBACK -->

              <% if (
                item.reviewFeedback
              ) { %>

                <div
                  class="mx-7 md:mx-8 mb-7 rounded-2xl bg-gray-50 border border-gray-100 p-5"
                >

                  <p
                    class="font-bold text-gray-900 mb-2"
                  >
                    Current Reviewer Feedback
                  </p>

                  <p
                    class="text-slate-600 whitespace-pre-line"
                  >
                    <%= item.reviewFeedback %>
                  </p>


                  <% if (item.reviewedAt) { %>

                    <p
                      class="text-sm text-slate-500 mt-3"
                    >
                      Reviewed
                      <%= new Date(item.reviewedAt).toLocaleString() %>

                      <% if (item.reviewedBy?.name) { %>
                        by <%= item.reviewedBy.name %>
                      <% } %>
                    </p>

                  <% } %>

                </div>

              <% } %>


              <!-- =================================================
                   REVIEW FORM
                   ================================================= -->

              <% if (!isAccepted) { %>

                <form
                  action="/admin/assignments/<%= item._id %>/review"
                  method="POST"
                  class="border-t border-gray-100 p-7 md:p-8"
                >

                  <input
                    type="hidden"
                    name="returnAcademy"
                    value="<%= selectedAcademy || '' %>"
                  />

                  <input
                    type="hidden"
                    name="returnStatus"
                    value="<%= selectedStatus || '' %>"
                  />


                  <div
                    class="mb-5"
                  >

                    <label
                      for="feedback-<%= item._id %>"
                      class="block text-sm font-semibold text-gray-800 mb-2"
                    >
                      Reviewer Feedback
                    </label>


                    <textarea
                      id="feedback-<%= item._id %>"
                      name="reviewFeedback"
                      rows="4"
                      class="w-full rounded-2xl border border-gray-200 px-4 py-3.5 resize-none outline-none focus:border-[#6B46C1] focus:ring-2 focus:ring-purple-100"
                      placeholder="Optional for acceptance. Required when requesting revision."
                    ><%= item.reviewFeedback || "" %></textarea>

                  </div>


                  <div
                    class="flex flex-col sm:flex-row gap-3"
                  >

                    <button
                      type="submit"
                      name="action"
                      value="accept"
                      class="rounded-2xl bg-green-600 text-white px-6 py-3.5 font-bold hover:bg-green-700 transition"
                      onclick="return confirm('Accept this assignment?')"
                    >
                      ✓ Accept Assignment
                    </button>


                    <button
                      type="submit"
                      name="action"
                      value="revision"
                      class="rounded-2xl bg-white border border-orange-300 text-orange-700 px-6 py-3.5 font-bold hover:bg-orange-50 transition"
                    >
                      Request Revision
                    </button>

                  </div>

                </form>

              <% } else { %>


                <div
                  class="border-t border-gray-100 p-7 md:p-8"
                >

                  <div
                    class="rounded-2xl border border-green-200 bg-green-50 p-5"
                  >

                    <p
                      class="font-extrabold text-green-800"
                    >
                      ✓ This assignment has been accepted.
                    </p>


                    <% if (item.acceptedAt) { %>

                      <p
                        class="text-green-700 text-sm mt-1"
                      >
                        Accepted
                        <%= new Date(item.acceptedAt).toLocaleString() %>
                      </p>

                    <% } %>

                  </div>

                </div>

              <% } %>


            </article>

          <% }) %>

        </div>


      </div>

    </main>

  </div>


  <script
    src="/js/admin-shell.js"
  ></script>


</body>

</html>