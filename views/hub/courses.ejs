<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= academy.name %> Courses</title>
  <link rel="icon" type="image/png" href="/images/tcem-logo.png" />
<link rel="apple-touch-icon" href="/images/tcem-logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css" />
  <style>
  /*
   * Leaves enough space above a targeted course card
   * because the website header is sticky.
   */
  .course-scroll-target {
    scroll-margin-top: 9rem;

    transition:
      border-color 250ms ease,
      box-shadow 250ms ease,
      transform 250ms ease;
  }

  /*
   * Light-mode target highlight.
   */
  .course-scroll-target:target {
    border-color: #6b46c1;

    box-shadow:
      0 20px 45px rgba(15, 23, 42, 0.12);

    transform: translateY(-3px);
  }


  /* =========================================================
     ACADEMY COURSES PAGE - DARK MODE
     =========================================================
     Covers:
     - Hero
     - Courses/Documents navigation
     - Available Courses
     - Level headings
     - Course cards
     - Locked states
     - Payment messages
     - Help panel

     No glow effects.
     ========================================================= */


  /* =========================================================
     1. PAGE CANVAS
     ========================================================= */

  html[data-theme="dark"]
  body.academy-courses-page {
    background: #0f0f18 !important;
    color: #d7d4df;
  }


  /* =========================================================
     2. HERO
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  > section:first-of-type {
    background-image:
      linear-gradient(
        120deg,
        #27205e 0%,
        #4c1d95 50%,
        #701a75 100%
      ) !important;

    border-bottom:
      1px solid rgba(139, 92, 246, 0.18);

    box-shadow: none;
  }


  /*
   * Breadcrumb and hero text remain light.
   */

  html[data-theme="dark"]
  .academy-courses-page
  > section:first-of-type
  h1 {
    color: #ffffff !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  > section:first-of-type
  .text-white\/80 {
    color:
      rgba(255, 255, 255, 0.78) !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  > section:first-of-type
  .text-white\/90 {
    color:
      rgba(255, 255, 255, 0.90) !important;
  }


  /* =========================================================
     3. HERO PRIMARY WHITE BUTTON
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  > section:first-of-type
  a.bg-white {
    background: #ffffff !important;

    color: #4f46e5 !important;

    border-color: transparent !important;

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  > section:first-of-type
  a.bg-white:hover {
    background: #f3f1f8 !important;

    color: #4338ca !important;

    box-shadow: none !important;
  }


  /* =========================================================
     4. COURSES / DOCUMENTS SUB-NAV
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  > section:first-of-type
  .border-t {
    border-top-color:
      rgba(255, 255, 255, 0.12) !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  > section:first-of-type
  a {
    color:
      rgba(255, 255, 255, 0.76);
  }


  html[data-theme="dark"]
  .academy-courses-page
  > section:first-of-type
  a:hover {
    color: #ffffff;
  }


  /* Active Courses tab */

  html[data-theme="dark"]
  .academy-courses-page
  a[href$="/courses"].border-white {
    color: #ffffff !important;

    border-bottom-color:
      #ffffff !important;
  }


  /* =========================================================
     5. AVAILABLE COURSES HEADING
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .text-gray-950 {
    color: #f8f7fb !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  .text-gray-900 {
    color: #e7e4ed !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  .text-slate-700 {
    color: #c9c6d1 !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  .text-slate-600 {
    color: #aaa6b4 !important;
  }


  /* =========================================================
     6. PAYMENT STATUS - PENDING
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-blue-50 {
    background:
      rgba(59, 130, 246, 0.10) !important;

    color:
      #93c5fd !important;

    border-color:
      rgba(96, 165, 250, 0.22) !important;
  }


  /* =========================================================
     7. PAYMENT STATUS - ALREADY UNLOCKED
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-green-50 {
    background:
      rgba(34, 197, 94, 0.10) !important;

    color:
      #86efac !important;

    border-color:
      rgba(74, 222, 128, 0.22) !important;
  }


  /* =========================================================
     8. EMPTY COURSES CARD
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .border-gray-200.bg-white {
    background: #191921 !important;

    border-color:
      rgba(255, 255, 255, 0.08) !important;

    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.18) !important;
  }


  /* =========================================================
     9. LEVEL HEADINGS
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  section.space-y-6
  h3.text-gray-950 {
    color: #f8f7fb !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  section.space-y-6
  p.text-slate-600 {
    color: #aaa6b4 !important;
  }


  /* =========================================================
     10. LEVEL PRICE BADGE
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-purple-100 {
    background:
      rgba(139, 92, 246, 0.14) !important;

    color:
      #c4b5fd !important;

    border:
      1px solid rgba(139, 92, 246, 0.20);
  }


  /* =========================================================
     11. UNLOCKED BADGE
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-green-100 {
    background:
      rgba(34, 197, 94, 0.12) !important;

    color:
      #86efac !important;

    border:
      1px solid rgba(74, 222, 128, 0.18);
  }


  /* =========================================================
     12. PENDING VERIFICATION BADGE
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-blue-100 {
    background:
      rgba(59, 130, 246, 0.12) !important;

    color:
      #93c5fd !important;

    border:
      1px solid rgba(96, 165, 250, 0.18);
  }


  /* =========================================================
     13. LOCKED BADGE
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-yellow-100 {
    background:
      rgba(234, 179, 8, 0.12) !important;

    color:
      #fde68a !important;

    border:
      1px solid rgba(250, 204, 21, 0.18);
  }


  /* =========================================================
     14. COURSE CARDS
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target {
    background: #191921 !important;

    border-color:
      rgba(139, 92, 246, 0.16) !important;

    box-shadow:
      0 14px 30px rgba(0, 0, 0, 0.20) !important;
  }


  /*
   * Course target selected from the DBW Featured Courses
   * section.
   *
   * Purple border, but NO purple glow.
   */

  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target:target {
    border-color:
      #8b5cf6 !important;

    box-shadow:
      0 18px 36px rgba(0, 0, 0, 0.30) !important;

    transform:
      translateY(-3px);
  }


  /* =========================================================
     15. COURSE IMAGE
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target img {
    background: #11111b;
  }


  /* =========================================================
     16. LOCKED LEVEL IMAGE BADGE
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target
  .bg-white\/95 {
    background:
      rgba(25, 25, 33, 0.94) !important;

    color:
      #f8f7fb !important;

    border:
      1px solid rgba(255, 255, 255, 0.10);

    box-shadow: none !important;

    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }


  /* =========================================================
     17. COURSE TITLES
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target
  h3 {
    color: #f8f7fb !important;
  }


  /* =========================================================
     18. COURSE DESCRIPTION
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target
  .text-slate-700 {
    color: #c9c6d1 !important;
  }


  /* =========================================================
     19. COURSE META
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target
  .text-slate-600 {
    color: #aaa6b4 !important;
  }


  /* =========================================================
     20. LOCKED COURSE PAYMENT NOTICE
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target
  .bg-gray-50 {
    background: #20202a !important;

    border-color:
      rgba(255, 255, 255, 0.08) !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target
  .bg-gray-50
  p {
    color: #aaa6b4 !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  .course-scroll-target
  .bg-gray-50
  .text-gray-900 {
    color: #f8f7fb !important;
  }


  /* =========================================================
     21. STANDARD INDIGO COURSE BUTTON
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-\[\#4F46E5\] {
    background: #5b4bd6 !important;

    color: #ffffff !important;

    border:
      1px solid rgba(129, 140, 248, 0.20);

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  .bg-\[\#4F46E5\]:hover {
    background: #6757e0 !important;

    box-shadow: none !important;
  }


  /* =========================================================
     22. MANUAL PAYMENT / SIGN-IN BUTTON
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-\[\#6B46C1\] {
    background: #7044d4 !important;

    color: #ffffff !important;

    border:
      1px solid rgba(167, 139, 250, 0.22);

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  .bg-\[\#6B46C1\]:hover {
    background: #7c4ce0 !important;

    box-shadow: none !important;
  }


  /* =========================================================
     23. PENDING VERIFICATION BUTTON
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  button.bg-yellow-500 {
    background: #a16207 !important;

    color: #ffffff !important;

    border:
      1px solid rgba(250, 204, 21, 0.16);

    box-shadow: none !important;
  }


  /* =========================================================
     24. HELP CHOOSING A COURSE PANEL
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-indigo-50\/70 {
    background: #191921 !important;

    border-color:
      rgba(139, 92, 246, 0.16) !important;

    box-shadow:
      0 14px 30px rgba(0, 0, 0, 0.18);
  }


  html[data-theme="dark"]
  .academy-courses-page
  .bg-indigo-50\/70
  h3 {
    color: #f8f7fb !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  .bg-indigo-50\/70
  p {
    color: #c9c6d1 !important;
  }


  /* =========================================================
     25. CONTACT ADVISOR BUTTON
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .bg-indigo-50\/70
  a {
    background: #7044d4 !important;

    color: #ffffff !important;

    border:
      1px solid rgba(167, 139, 250, 0.22);

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-courses-page
  .bg-indigo-50\/70
  a:hover {
    background: #7c4ce0 !important;

    color: #ffffff !important;

    box-shadow: none !important;
  }


  /* =========================================================
     26. REMOVE GLOW / GENERIC LIGHT SHADOWS
     ========================================================= */

  html[data-theme="dark"]
  .academy-courses-page
  .shadow,

  html[data-theme="dark"]
  .academy-courses-page
  .shadow-sm,

  html[data-theme="dark"]
  .academy-courses-page
  .shadow-md {
    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.18) !important;
  }


  /*
   * Buttons remain flat.
   */

  html[data-theme="dark"]
  .academy-courses-page
  a.shadow-sm,

  html[data-theme="dark"]
  .academy-courses-page
  a.shadow-md,

  html[data-theme="dark"]
  .academy-courses-page
  button.shadow-sm,

  html[data-theme="dark"]
  .academy-courses-page
  button.shadow-md {
    box-shadow: none !important;
  }


  /* =========================================================
     27. MOBILE
     ========================================================= */

  @media (max-width: 767px) {

    .course-scroll-target {
      scroll-margin-top: 7rem;
    }


    html[data-theme="dark"]
    .academy-courses-page
    .course-scroll-target {
      box-shadow:
        0 10px 22px rgba(0, 0, 0, 0.18) !important;
    }


    html[data-theme="dark"]
    .academy-courses-page
    .course-scroll-target:target {
      border-color:
        #8b5cf6 !important;

      box-shadow:
        0 12px 26px rgba(0, 0, 0, 0.24) !important;

      transform: none;
    }


    html[data-theme="dark"]
    .academy-courses-page
    .bg-indigo-50\/70 {
      box-shadow:
        0 10px 22px rgba(0, 0, 0, 0.16);
    }

  }
</style>
</head>
<body class="academy-courses-page bg-[#f7f7f8] text-gray-900">

  <%- include("../partials/header") %>

  <section class="bg-gradient-to-r from-[#4F46E5] via-[#7C3AED] to-[#C026D3] text-white">
    <div class="max-w-7xl mx-auto px-6 md:px-16 py-10 md:py-12">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div>
          <p class="text-white/80 text-sm md:text-base mb-3">
            <a href="/academy" class="hover:text-white transition">Academy</a>
            <span class="mx-2">/</span>
            <span class="font-semibold"><%= academy.name %></span>
          </p>
          <h1 class="text-3xl md:text-5xl font-extrabold mb-3"><%= academy.name %></h1>
          <p class="text-lg md:text-2xl text-white/90">
            <%= academy.shortDescription || "Your online learning platform." %>
          </p>
        </div>

        <% if (!isLoggedIn) { %>
          <a
            href="#"
            class="open-auth-modal inline-flex items-center justify-center rounded-2xl bg-white text-[#4F46E5] px-8 py-4 text-lg font-semibold shadow-sm hover:shadow-md transition self-start lg:self-auto"
            data-modal-mode="login"
            data-redirect-after-auth="/academy/<%= academy.slug %>/courses"
          >
            Sign In / Register
          </a>
        <% } else { %>
          <a
            href="/academy/<%= academy.slug %>/documents"
            class="inline-flex items-center justify-center rounded-2xl bg-white text-[#4F46E5] px-8 py-4 text-lg font-semibold shadow-sm hover:shadow-md transition self-start lg:self-auto"
          >
            My Documents
          </a>
        <% } %>
      </div>
    </div>

    <div class="border-t border-white/15">
      <div class="max-w-7xl mx-auto px-6 md:px-16">
        <div class="flex items-center gap-8 overflow-x-auto">
          <a href="/academy/<%= academy.slug %>/courses" class="inline-flex h-14 items-center border-b-2 border-white text-white font-semibold whitespace-nowrap">
            <span class="mr-2">📖</span>
            Courses
          </a>
          <a href="/academy/<%= academy.slug %>/documents" class="inline-flex h-14 items-center border-b-2 border-transparent text-white/70 font-medium whitespace-nowrap hover:text-white transition">
            <span class="mr-2">📄</span>
            Documents
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="pt-12 md:pt-14 pb-10">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <h2 class="text-4xl md:text-5xl font-extrabold text-gray-950 mb-4">
        Available Courses
      </h2>
      <p class="text-lg md:text-2xl text-slate-600 max-w-4xl">
        Explore the courses available in <%= academy.name %> and unlock each level to access its grouped courses, documents, audios, and assignments.
      </p>
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="max-w-7xl mx-auto px-6 md:px-16">

      <% if (payment === "pending") { %>
        <div class="mb-8 rounded-2xl border border-blue-200 bg-blue-50 px-5 py-4 text-blue-700 font-medium">
          Your payment request has been submitted and is awaiting admin verification.
        </div>
      <% } %>

      <% if (payment === "already-unlocked") { %>
        <div class="mb-8 rounded-2xl border border-green-200 bg-green-50 px-5 py-4 text-green-700 font-medium">
          You already have access to this level.
        </div>
      <% } %>

      <% if (!groupedLevels || !groupedLevels.length) { %>
        <div class="rounded-[26px] border border-gray-200 bg-white p-10 text-center shadow-sm">
          <h3 class="text-2xl md:text-3xl font-extrabold text-gray-950 mb-3">
            No course levels available yet
          </h3>
          <p class="text-lg text-slate-600">
            Published levels and courses will appear here automatically.
          </p>
        </div>
      <% } else { %>
        <div class="space-y-12">
          <% groupedLevels.forEach((level) => { %>
            <section class="space-y-6">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                  <h3 class="text-3xl md:text-4xl font-extrabold text-gray-950 mb-2">
                    <%= level.title %>
                  </h3>
                  <p class="text-lg text-slate-600">
                    <%= level.description || "Grouped courses for this level." %>
                  </p>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  <% if (level.price) { %>
                    <span class="inline-flex rounded-full bg-purple-100 text-purple-700 px-4 py-2 text-sm font-semibold">
                      <%= level.price %>
                    </span>
                  <% } %>

                  <% if (level.isUnlocked) { %>
                    <span class="inline-flex rounded-full bg-green-100 text-green-700 px-4 py-2 text-sm font-semibold">
                      Unlocked
                    </span>
                  <% } else if (level.hasPendingRequest) { %>
                    <span class="inline-flex rounded-full bg-blue-100 text-blue-700 px-4 py-2 text-sm font-semibold">
                      Pending Verification
                    </span>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-yellow-100 text-yellow-700 px-4 py-2 text-sm font-semibold">
                      Locked
                    </span>
                  <% } %>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                <% level.courses.forEach((course) => { %>
                  <article id="course-<%= course.slug %>" class="course-scroll-target bg-white border border-indigo-100 rounded-[26px] shadow-sm overflow-hidden <%= !level.isUnlocked ? 'opacity-95' : '' %>">
                    <div class="relative h-56 overflow-hidden">
                      <img
                        src="<%= course.image || '/images/event1.jpg' %>"
                        alt="<%= course.title %>"
                        class="w-full h-full object-cover <%= !level.isUnlocked ? 'grayscale-[20%]' : '' %>"
                      />

                      <% if (!level.isUnlocked) { %>
                        <div class="absolute top-4 left-4">
                          <span class="inline-flex rounded-full bg-white/95 text-gray-900 px-4 py-2 text-sm font-semibold shadow">
                            🔒 Locked Level
                          </span>
                        </div>
                      <% } %>
                    </div>

                    <div class="p-6 md:p-7">
                      <h3 class="text-2xl font-extrabold text-gray-950 mb-4 leading-snug">
                        <%= course.title %>
                      </h3>

                      <p class="text-lg leading-relaxed text-slate-700 mb-5 line-clamp-3">
                        <%= course.description %>
                      </p>

                      <div class="flex flex-wrap items-center gap-5 text-base text-slate-600 mb-5">
                        <span class="inline-flex items-center gap-2">
                          <span>🕒</span>
                          <%= course.duration || "Not specified" %>
                        </span>

                        <span class="inline-flex items-center gap-2">
                          <span>▶</span>
                          <%= course.lessons || "Not specified" %>
                        </span>
                      </div>

                      <% if (!level.isUnlocked) { %>
                        <div class="mb-5 rounded-2xl bg-gray-50 border border-gray-200 px-4 py-4">
                          <p class="text-sm text-slate-600">
                            Pay for <span class="font-semibold text-gray-900"><%= level.title %></span> to unlock all courses in this level.
                          </p>
                        </div>
                      <% } %>

                      <% if (level.isUnlocked) { %>
                        <a
                          href="/academy/<%= academy.slug %>/courses/<%= course.slug %>"
                          class="w-full inline-flex items-center justify-center rounded-2xl text-white px-6 py-4 text-lg font-semibold transition <%= course.buttonClass || 'bg-[#4F46E5] hover:bg-indigo-700' %>"
                        >
                          <%= course.buttonText || "View Course" %>
                        </a>
                      <% } else { %>
                        <% if (level.hasPendingRequest) { %>
                          <button
                            type="button"
                            class="w-full inline-flex items-center justify-center rounded-2xl bg-yellow-500 text-white px-6 py-4 text-lg font-semibold cursor-not-allowed"
                            disabled
                          >
                            Pending Verification
                          </button>
                        <% } else if (isLoggedIn) { %>
                          <a
                            href="/academy/<%= academy.slug %>/manual-payment/levels/<%= level._id %>"
                            class="w-full inline-flex items-center justify-center rounded-2xl bg-[#6B46C1] text-white px-6 py-4 text-lg font-semibold hover:bg-purple-700 transition"
                          >
                            Pay Manually
                          </a>
                        <% } else { %>
                          <a
                            href="#"
                            class="open-auth-modal w-full inline-flex items-center justify-center rounded-2xl bg-[#6B46C1] text-white px-6 py-4 text-lg font-semibold hover:bg-purple-700 transition"
                            data-modal-mode="login"
                            data-redirect-after-auth="/academy/<%= academy.slug %>/courses"
                          >
                            Sign In / Register
                          </a>
                        <% } %>
                      <% } %>
                    </div>
                  </article>
                <% }) %>
              </div>
            </section>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="pb-20 md:pb-24">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <div class="rounded-[28px] border border-indigo-100 bg-indigo-50/70 p-8 md:p-10">
        <h3 class="text-3xl md:text-4xl font-extrabold text-gray-950 mb-4">
          Need Help Choosing a Course?
        </h3>
        <p class="text-lg md:text-[1.15rem] text-slate-700 leading-relaxed mb-6">
          Contact our academic advisor for guidance on the right starting level in <%= academy.name %>.
        </p>

        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-2xl bg-[#4F46E5] text-white px-8 py-4 text-lg font-semibold hover:bg-indigo-700 transition shadow-sm"
        >
          Contact Advisor
        </a>
      </div>
    </div>
  </section>

  <%- include("../partials/footer") %>
  <%- include("../partials/auth-modal") %>
  <script src="/js/auth-modal.js"></script>

</body>
</html>