  .dbw-resource-layout {

    grid-template-columns:

      2.6rem minmax(0, 1fr);

    gap:

      0.85rem;

  }

  .dbw-resource-number {

    width:

      2.6rem;

    height:

      2.6rem;

  }

  .dbw-resource-actions {

    display:

      grid;

    grid-template-columns:

      1fr;

  }

  .dbw-resource-primary-action,

  .dbw-resource-secondary-action {

    width:

      100%;

  }

}

/* =========================================================
   DBW V2 PROGRESS
   ========================================================= */

.dbw-course-progress {
  margin-bottom: 2rem;
  padding-bottom: 1.75rem;
  border-bottom: 1px solid #e5e7eb;
}

.dbw-course-progress-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.8rem;
  color: #64748b;
  font-size: 0.9rem;
}

.dbw-course-progress-top > div {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
}

.dbw-course-progress-label {
  font-weight: 700;
}

.dbw-course-progress-top strong {
  color: #111827;
  font-size: 1.25rem;
}

.dbw-course-progress-track {
  width: 100%;
  height: 0.55rem;
  overflow: hidden;
  border-radius: 9999px;
  background: #e5e7eb;
}

.dbw-course-progress-fill {
  width: 0;
  height: 100%;
  border-radius: inherit;
  background: #6b46c1;
  transition: width 0.3s ease;
}

.dbw-course-complete-message {
  margin-top: 0.8rem;
  color: #15803d;
  font-weight: 800;
}

.dbw-progress-badge {
  display: inline-flex;
  padding: 0.23rem 0.55rem;
  border-radius: 9999px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 0.68rem;
  font-weight: 700;
}

.dbw-progress-badge.is-progress {
  background: #eff6ff;
  color: #1d4ed8;
}

.dbw-progress-badge.is-completed {
  background: #dcfce7;
  color: #15803d;
}

.dbw-audio-progress-text {
  min-height: 1.25rem;
  margin-top: 0.6rem;
  color: #64748b;
  font-size: 0.88rem;
}

.dbw-audio-progress-text strong {
  color: #6b46c1;
}

.dbw-manual-complete-button {
  margin-top: 1rem;
  padding: 0.7rem 1rem;
  border: 1px solid #6b46c1;
  border-radius: 0.8rem;
  background: transparent;
  color: #6b46c1;
  font-weight: 700;
  cursor: pointer;
}

.dbw-manual-complete-button:hover {
  background: #f5f3ff;
}

.dbw-manual-complete-button:disabled {
  opacity: 0.6;
  cursor: wait;
}

html[data-theme="dark"]
.academy-course-detail-page
.dbw-course-progress {
  border-color: rgba(255, 255, 255, 0.09);
}

html[data-theme="dark"]
.academy-course-detail-page
.dbw-course-progress-top,
html[data-theme="dark"]
.academy-course-detail-page
.dbw-audio-progress-text {
  color: #aaa6b4;
}

html[data-theme="dark"]
.academy-course-detail-page
.dbw-course-progress-top strong {
  color: #f8f7fb;
}

html[data-theme="dark"]
.academy-course-detail-page
.dbw-course-progress-track {
  background: rgba(255, 255, 255, 0.1);
}

html[data-theme="dark"]
.academy-course-detail-page
.dbw-progress-badge {
  background: rgba(255, 255, 255, 0.06);
  color: #aaa6b4;
}

html[data-theme="dark"]
.academy-course-detail-page
.dbw-progress-badge.is-progress {
  background: rgba(59, 130, 246, 0.12);
  color: #93c5fd;
}

html[data-theme="dark"]
.academy-course-detail-page
.dbw-progress-badge.is-completed {
  background: rgba(34, 197, 94, 0.12);
  color: #86efac;
}

html[data-theme="dark"]
.academy-course-detail-page
.dbw-manual-complete-button {
  border-color: rgba(139, 92, 246, 0.5);
  color: #c4b5fd;
}

html[data-theme="dark"]
.academy-course-detail-page
.dbw-manual-complete-button:hover {
  background: rgba(139, 92, 246, 0.08);
}

@media (max-width: 640px) {
  .dbw-course-progress-top {
    align-items: flex-start;
    flex-direction: column;
  }
}

</style>

</head>

<body class="academy-course-detail-page bg-[#f7f7f8] text-gray-900">

  <%- include("../partials/header") %>

  <!-- COURSE HERO -->

  <section

    class="bg-gradient-to-r from-[#4F46E5] via-[#7C3AED] to-[#C026D3] text-white"

  >

    <div class="max-w-7xl mx-auto px-6 md:px-16 py-10 md:py-12">

      <div

        class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"

      >

        <div>

          <p class="text-white/80 text-sm md:text-base mb-3">

            <a

              href="/academy"

              class="hover:text-white transition"

            >

              Academy

            </a>

            <span class="mx-2">/</span>

            <a

              href="/academy/<%= academy.slug %>"

              class="hover:text-white transition"

            >

              <%= academy.name %>

            </a>

            <span class="mx-2">/</span>

            <a

              href="/academy/<%= academy.slug %>/courses"

              class="hover:text-white transition"

            >

              Courses

            </a>

            <span class="mx-2">/</span>

            <span class="text-white font-semibold">

              <%= course.title %>

            </span>

          </p>

          <h1 class="text-3xl md:text-5xl font-extrabold mb-3">

            <%= course.title %>

          </h1>

          <p class="text-lg md:text-2xl text-white/90 max-w-4xl">

            <%= course.description %>

          </p>

        </div>

        <% if (isLoggedIn) { %>

          <a

            href="/academy/<%= academy.slug %>/documents"

            class="inline-flex items-center justify-center rounded-2xl bg-white text-[#4F46E5] px-8 py-4 text-lg font-semibold shadow-sm hover:shadow-md transition self-start lg:self-auto"

          >

            My Documents

          </a>

        <% } else { %>

          <a

            href="/academy/<%= academy.slug %>"

            class="inline-flex items-center justify-center rounded-2xl bg-white text-[#4F46E5] px-8 py-4 text-lg font-semibold shadow-sm hover:shadow-md transition self-start lg:self-auto"

          >

            Back to Academy

          </a>

        <% } %>

      </div>

    </div>

    <!-- ACADEMY NAVIGATION -->

    <div class="border-t border-white/15">

      <div class="max-w-7xl mx-auto px-6 md:px-16">

        <div class="flex items-center gap-8 overflow-x-auto">

          <a

            href="/academy/<%= academy.slug %>/courses"

            class="inline-flex h-14 items-center border-b-2 border-white text-white font-semibold whitespace-nowrap"

          >

            <span class="mr-2" aria-hidden="true">📖</span>

            Courses

          </a>

          <a

            href="/academy/<%= academy.slug %>/documents"

            class="inline-flex h-14 items-center border-b-2 border-transparent text-white/70 font-medium whitespace-nowrap hover:text-white transition"

          >

            <span class="mr-2" aria-hidden="true">📄</span>

            Documents

          </a>

        </div>

      </div>

    </div>

  </section>

  <!-- COURSE CONTENT -->

  <section class="py-12 md:py-14">

    <div class="max-w-7xl mx-auto px-6 md:px-16">

      <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">

        <!-- MAIN COLUMN -->

        <div class="xl:col-span-2 space-y-8">

          <!-- COURSE IMAGE -->

          <div

            class="bg-white border border-gray-100 rounded-[28px] shadow-sm overflow-hidden"

          >

            <img

              src="<%= courseImageUrl %>"

              alt="<%= course.title %>"

              width="1200"

              height="675"

              loading="eager"

              fetchpriority="high"

              decoding="async"

              class="course-featured-image"

              onerror="this.onerror=null; this.src='/images/event1.jpg';"

            />

          </div>

          <!-- COURSE OVERVIEW -->

          <div

            class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-8 md:p-10"

          >

            <h2

              class="text-3xl md:text-4xl font-extrabold text-gray-950 mb-5"

            >

              Course Overview

            </h2>

            <p

              class="text-lg md:text-[1.15rem] leading-relaxed text-slate-700 whitespace-pre-line"

            >

              <%= course.overview || course.description %>

            </p>

          </div>

          <!-- =====================================================

     DBW V2 LEARNING MATERIALS

     ===================================================== -->

<% if (isResourceMode) { %>

  <%- include(

  "./course-resources",

  {

    academy,

    course,

    resources,

    submissionByResource,

    resourceProgressById,

    courseProgress,

    assignmentStatus

  }

) %>

<% } %>

        </div>

        <!-- SIDEBAR -->

        <aside class="space-y-8">

          <!-- COURSE DETAILS -->

          <div

            class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-8"

          >

            <h2

              class="text-2xl md:text-3xl font-extrabold text-gray-950 mb-6"

            >

              Course Details

            </h2>

            <div class="space-y-4 text-base md:text-lg text-slate-700">

              <div class="flex items-start justify-between gap-4">

                <span class="font-semibold shrink-0">Duration</span>

                <span class="text-right break-words min-w-0">

                  <%= course.duration || "Not specified" %>

                </span>

              </div>

              <% if (isResourceMode) { %>

  <!-- DBW V2 COURSE DETAILS -->

  <div class="flex items-start justify-between gap-4">

    <span class="font-semibold shrink-0">

      Materials

    </span>

    <span class="text-right">

      <%= resources ? resources.length : 0 %>

    </span>

  </div>

<% } else { %>

  <!-- LEGACY COURSE DETAILS -->

  <div class="flex items-start justify-between gap-4">

    <span class="font-semibold shrink-0">

      Lessons

    </span>

    <span class="text-right break-words min-w-0">

      <%= course.lessons || "Not specified" %>

    </span>

  </div>

  <div class="flex items-start justify-between gap-4">

    <span class="font-semibold shrink-0">

      Students

    </span>

    <span class="text-right">

      <%= course.students || 0 %>

    </span>

  </div>

  <div class="flex items-start justify-between gap-4">

    <span class="font-semibold shrink-0">

      Rating

    </span>

    <span class="text-right">

      <%= course.rating || 0 %>

    </span>

  </div>

<% } %>

            </div>

          </div>

          <!-- WHAT YOU WILL LEARN — DESKTOP SIDEBAR -->

<div

  class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-8"

>

  <h2

    class="text-2xl md:text-3xl font-extrabold text-gray-950 mb-6"

  >

    What You Will Learn

  </h2>

  <% if (

    course.whatYouWillLearn &&

    course.whatYouWillLearn.length

  ) { %>

    <div class="space-y-4">

      <% course.whatYouWillLearn.forEach((item) => { %>

        <div

          class="flex items-start gap-3"

        >

          <span

            class="text-[#6B46C1] font-bold mt-0.5"

            aria-hidden="true"

          >

            ✓

          </span>

          <p

            class="text-base text-slate-700 leading-relaxed"

          >

            <%= item %>

          </p>

        </div>

      <% }) %>

    </div>

  <% } else { %>

    <p class="text-base text-slate-600">

      No learning outcomes added yet.

    </p>

  <% } %>

</div>

          <% if (!isResourceMode) { %>

          <!-- COURSE DOCUMENTS -->

          <div

            class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-8"

          >

            <h2

              class="text-2xl md:text-3xl font-extrabold text-gray-950 mb-6"

            >

              Course Documents

            </h2>

            <% if (

              course.courseDocuments &&

              course.courseDocuments.length

            ) { %>

              <div class="space-y-4">

                <% course.courseDocuments.forEach((doc, index) => { %>

                  <a

                    href="<%= doc.fileUrl %>"

                    target="_blank"

                    rel="noopener noreferrer"

                    class="course-file-row flex items-center justify-between gap-4 rounded-2xl border border-gray-100 bg-gray-50/80 px-5 py-4 hover:border-[#6B46C1] hover:bg-purple-50/40 transition"

                  >

                    <div

                      class="course-file-information flex items-start gap-3"

                    >

                      <span

                        class="text-2xl shrink-0"

                        aria-hidden="true"

                      >

                        📄

                      </span>

                      <div class="course-file-information">

                        <p class="font-semibold text-gray-900">

                          Document <%= index + 1 %>

                        </p>

                        <p

                          class="course-file-name text-sm text-slate-600"

                          title="<%= doc.originalName || 'Course document' %>"

                        >

                          <%= doc.originalName || "Course document" %>

                        </p>

                      </div>

                    </div>

                    <span

                      class="text-[#6B46C1] font-semibold shrink-0"

                    >

                      Open

                    </span>

                  </a>

                <% }) %>

              </div>

            <% } else { %>

              <p class="text-lg text-slate-600">

                No course documents uploaded yet.

              </p>

            <% } %>

          </div>

          <!-- COURSE AUDIOS -->

          <div

            class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-8"

          >

            <h2

              class="text-2xl md:text-3xl font-extrabold text-gray-950 mb-6"

            >

              Course Audios

            </h2>

            <% if (

              course.courseAudios &&

              course.courseAudios.length

            ) { %>

              <div class="space-y-5">

                <% course.courseAudios.forEach((audio, index) => { %>

                  <div

                    class="course-audio-card rounded-2xl border border-gray-100 bg-gray-50/80 px-5 py-4"

                  >

                    <div class="course-audio-header">

                      <span

                        class="text-2xl shrink-0"

                        aria-hidden="true"

                      >

                        🎧

                      </span>

                      <div class="course-audio-information">

                        <p class="font-semibold text-gray-900">

                          Audio <%= index + 1 %>

                        </p>

                        <p

                          class="course-file-name text-sm text-slate-600"

                          title="<%= audio.originalName || 'Course audio' %>"

                        >

                          <%= audio.originalName || "Course audio" %>

                        </p>

                      </div>

                    </div>

                    <audio

                      controls

                      preload="metadata"

                      class="course-audio-player"

                    >

                      <source

                        src="<%= audio.fileUrl %>"

                        type="<%= audio.mimeType || 'audio/mpeg' %>"

                      />

                      Your browser does not support the audio player.

                    </audio>

                  </div>

                <% }) %>

              </div>

            <% } else { %>

              <p class="text-lg text-slate-600">

                No course audios uploaded yet.

              </p>

            <% } %>

          </div>

          <!-- ASSIGNMENT -->

          <div

            class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-8"

          >

            <h2

              class="text-2xl md:text-3xl font-extrabold text-gray-950 mb-6"

            >

              Assignment

            </h2>

            <% if (

              course.assignmentDocument &&

              course.assignmentDocument.fileUrl

            ) { %>

              <a

                href="<%= course.assignmentDocument.fileUrl %>"

                target="_blank"

                rel="noopener noreferrer"

                class="course-file-row flex items-center justify-between gap-4 rounded-2xl border border-gray-100 bg-gray-50/80 px-5 py-4 hover:border-[#6B46C1] hover:bg-purple-50/40 transition"

              >

                <div

                  class="course-file-information flex items-start gap-3"

                >

                  <span

                    class="text-2xl shrink-0"

                    aria-hidden="true"

                  >

                    📝

                  </span>

                  <div class="course-file-information">

                    <p class="font-semibold text-gray-900">

                      Assignment Document

                    </p>

                    <p

                      class="course-file-name text-sm text-slate-600"

                      title="<%= course.assignmentDocument.originalName || 'Assignment document' %>"

                    >

                      <%= course.assignmentDocument.originalName || "Assignment document" %>

                    </p>

                  </div>

                </div>

                <span

                  class="text-[#6B46C1] font-semibold shrink-0"

                >

                  Open

                </span>

              </a>

            <% } else { %>

              <p class="text-lg text-slate-600">

                No assignment document uploaded yet.

              </p>

            <% } %>

          </div>

          <% } %>

        </aside>

      </div>

    </div>

  </section>

  <%- include("../partials/footer") %>

</body>

</html>
