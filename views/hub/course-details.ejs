<%

  /*

   * Accepts different image formats that may have been saved in the database:

   * - "/uploads/image.jpg"

   * - "uploads/image.jpg"

   * - "public/images/image.jpg"

   * - { fileUrl: "..." }

   * - { url: "..." }

   * - { path: "..." }

   */

  const resolveMediaUrl = (media, fallback) => {

    let mediaUrl = media;

    if (mediaUrl && typeof mediaUrl === "object") {

      mediaUrl =

        mediaUrl.fileUrl ||

        mediaUrl.secureUrl ||

        mediaUrl.secure_url ||

        mediaUrl.url ||

        mediaUrl.path ||

        (mediaUrl.filename

          ? `/uploads/${mediaUrl.filename}`

          : "");

    }

    if (!mediaUrl || typeof mediaUrl !== "string") {

      return fallback;

    }

    mediaUrl = mediaUrl.trim().replace(/\\/g, "/");

    if (

      /^(https?:)?\/\//i.test(mediaUrl) ||

      mediaUrl.startsWith("data:") ||

      mediaUrl.startsWith("blob:")

    ) {

      return mediaUrl;

    }

    if (mediaUrl.startsWith("public/")) {

      return `/${mediaUrl.slice("public/".length)}`;

    }

    return mediaUrl.startsWith("/")

      ? mediaUrl

      : `/${mediaUrl}`;

  };

  const courseImageUrl = resolveMediaUrl(

    course.image || course.featuredImage || course.imageUrl,

    "/images/event1.jpg"

  );

  const pageDescription =

    typeof metaDescription !== "undefined" && metaDescription

      ? metaDescription

      : course.description ||

        `View course information for ${course.title}.`;

%>

<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta

    name="viewport"

    content="width=device-width, initial-scale=1.0"

  />

  <title><%= course.title %> | <%= academy.name %></title>

  <meta

    name="description"

    content="<%= pageDescription %>"

  />

  <% if (typeof canonicalUrl !== "undefined" && canonicalUrl) { %>

    <link rel="canonical" href="<%= canonicalUrl %>" />

  <% } %>

  <% if (typeof noindex !== "undefined" && noindex) { %>

    <meta name="robots" content="noindex" />

  <% } %>

  <link

    rel="icon"

    type="image/png"

    href="/images/tcem-logo.png"

  />

  <link

    rel="apple-touch-icon"

    href="/images/tcem-logo.png"

  />

  <link

    rel="preconnect"

    href="https://fonts.googleapis.com"

  />

  <link

    rel="preconnect"

    href="https://fonts.gstatic.com"

    crossorigin

  />

  <link

    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"

    rel="stylesheet"

  />

  <link rel="stylesheet" href="/css/style.css" />

  <style>

    /*

     * Prevent long document, audio and assignment names

     * from overflowing their cards.

     */

    .course-file-row {

      min-width: 0;

    }

    .course-file-information {

      flex: 1;

      min-width: 0;

    }

    .course-file-name {

      display: block;

      max-width: 100%;

      overflow-wrap: anywhere;

      word-break: break-word;

      line-height: 1.45;

    }

    .course-audio-card {

      min-width: 0;

      overflow: hidden;

    }

    .course-audio-header {

      display: flex;

      align-items: flex-start;

      gap: 0.75rem;

      min-width: 0;

      margin-bottom: 0.85rem;

    }

    .course-audio-information {

      flex: 1;

      min-width: 0;

    }

    .course-audio-player {

      display: block;

      width: 100%;

      max-width: 100%;

      min-width: 0;

    }

    /*

     * Makes the image area retain its space while loading.

     */

    .course-featured-image {

      display: block;

      width: 100%;

      height: 280px;

      object-fit: cover;

      background: #f1f5f9;

    }

    @media (min-width: 768px) {

      .course-featured-image {

        height: 420px;

      }

    }

    /* =========================================================

   ACADEMY COURSE DETAILS PAGE - DARK MODE

   =========================================================

   Covers:

   - Course hero

