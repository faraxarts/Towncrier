<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= academy.name %> Documents</title>
  <link rel="icon" type="image/png" href="/images/tcem-logo.png" />
<link rel="apple-touch-icon" href="/images/tcem-logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css" />
  <style>
  /* =========================================================
     ACADEMY DOCUMENTS / ASSIGNMENTS PAGE - DARK MODE
     =========================================================
     Covers:
     - Documents hero
     - Courses/Documents navigation
     - Assignment submission form
     - File upload field
     - Success message
     - Submission guide
     - Information panel
     - Submission history
     - Status badges

     Light mode remains unchanged.
     No glow effects.
     ========================================================= */


  /* =========================================================
     1. PAGE CANVAS
     ========================================================= */

  html[data-theme="dark"]
  body.academy-documents-page {
    background: #0f0f18 !important;
    color: #d7d4df;
  }


  /* =========================================================
     2. HERO
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  > section:first-of-type {
    background-image:
      linear-gradient(
        120deg,
        #27205e 0%,
        #4c1d95 50%,
        #701a75 100%
      ) !important;

    border-bottom:
      1px solid rgba(139, 92, 246, 0.18);

    box-shadow: none;
  }


  html[data-theme="dark"]
  .academy-documents-page
  > section:first-of-type
  h1 {
    color: #ffffff !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  > section:first-of-type
  .text-white\/90 {
    color:
      rgba(255, 255, 255, 0.90) !important;
  }


  /* =========================================================
     3. HERO WHITE BUTTON
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  > section:first-of-type
  a.bg-white {
    background: #ffffff !important;

    color: #4f46e5 !important;

    border-color: transparent !important;

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  > section:first-of-type
  a.bg-white:hover {
    background: #f3f1f8 !important;

    color: #4338ca !important;

    box-shadow: none !important;
  }


  /* =========================================================
     4. COURSES / DOCUMENTS NAVIGATION
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  > section:first-of-type
  .border-t {
    border-top-color:
      rgba(255, 255, 255, 0.12) !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  > section:first-of-type
  a {
    color:
      rgba(255, 255, 255, 0.72);
  }


  html[data-theme="dark"]
  .academy-documents-page
  > section:first-of-type
  a:hover {
    color: #ffffff;
  }


  /* Active Documents tab */

  html[data-theme="dark"]
  .academy-documents-page
  a[href$="/documents"].border-white {
    color: #ffffff !important;

    border-bottom-color:
      #ffffff !important;
  }


  /* =========================================================
     5. PAGE HEADINGS
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .text-gray-950 {
    color: #f8f7fb !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  .text-gray-900 {
    color: #e7e4ed !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  .text-gray-800 {
    color: #e1dee7 !important;
  }


  /* =========================================================
     6. BODY TEXT
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .text-slate-700 {
    color: #c9c6d1 !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  .text-slate-600 {
    color: #aaa6b4 !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  .text-slate-500 {
    color: #8e8a98 !important;
  }


  /* =========================================================
     7. MAIN FORM CARD
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .xl\:col-span-3.bg-white {
    background: #191921 !important;

    border-color:
      rgba(255, 255, 255, 0.08) !important;

    box-shadow:
      0 14px 30px rgba(0, 0, 0, 0.20) !important;
  }


  /* =========================================================
     8. SUCCESS MESSAGE
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .bg-green-50 {
    background:
      rgba(34, 197, 94, 0.10) !important;

    color:
      #86efac !important;

    border-color:
      rgba(74, 222, 128, 0.22) !important;
  }


  /* =========================================================
     9. FORM LABELS
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  form label {
    color: #e7e4ed !important;
  }


  /* =========================================================
     10. INPUTS / SELECT / TEXTAREA
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  form input,

  html[data-theme="dark"]
  .academy-documents-page
  form select,

  html[data-theme="dark"]
  .academy-documents-page
  form textarea {
    background: #11111b !important;

    color: #f8f7fb !important;

    border-color:
      rgba(255, 255, 255, 0.11) !important;

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  form input::placeholder,

  html[data-theme="dark"]
  .academy-documents-page
  form textarea::placeholder {
    color: #777482 !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  form select option {
    background: #191921;

    color: #f8f7fb;
  }


  /* =========================================================
     11. FORM FOCUS STATES
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  form input:focus,

  html[data-theme="dark"]
  .academy-documents-page
  form select:focus,

  html[data-theme="dark"]
  .academy-documents-page
  form textarea:focus {
    border-color:
      #8b5cf6 !important;

    outline: none !important;

    box-shadow:
      0 0 0 2px rgba(139, 92, 246, 0.10) !important;
  }


  /* =========================================================
     12. FILE INPUT
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  input[type="file"] {
    background: #11111b !important;

    color: #c9c6d1 !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  input[type="file"]::file-selector-button {
    border: none;

    border-radius: 0.75rem;

    background: #7044d4;

    color: #ffffff;

    padding:
      0.65rem 1rem;

    margin-right:
      1rem;

    font-weight: 600;

    cursor: pointer;
  }


  html[data-theme="dark"]
  .academy-documents-page
  input[type="file"]::file-selector-button:hover {
    background: #7c4ce0;
  }


  /* =========================================================
     13. UPLOAD ASSIGNMENT BUTTON
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  form button[type="submit"] {
    background: #7044d4 !important;

    color: #ffffff !important;

    border:
      1px solid rgba(167, 139, 250, 0.22);

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  form button[type="submit"]:hover {
    background: #7c4ce0 !important;

    box-shadow: none !important;
  }


  /* =========================================================
     14. SUBMISSION GUIDE CARD
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .xl\:col-span-2
  .bg-white {
    background: #191921 !important;

    border-color:
      rgba(255, 255, 255, 0.08) !important;

    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.18) !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  .xl\:col-span-2
  .bg-white h3 {
    color: #f8f7fb !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  .xl\:col-span-2
  .bg-white p {
    color: #c9c6d1 !important;
  }


  /* =========================================================
     15. KEEP YOUR WORK ORGANIZED PANEL
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .xl\:col-span-2
  .bg-gradient-to-r {
    background-image:
      linear-gradient(
        120deg,
        #27205e 0%,
        #4c1d95 50%,
        #701a75 100%
      ) !important;

    border:
      1px solid rgba(139, 92, 246, 0.18);

    box-shadow:
      0 14px 30px rgba(0, 0, 0, 0.22) !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  .xl\:col-span-2
  .bg-gradient-to-r
  h3 {
    color: #ffffff !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  .xl\:col-span-2
  .bg-gradient-to-r
  p {
    color:
      rgba(255, 255, 255, 0.90) !important;
  }


  /* =========================================================
     16. SUBMISSION HISTORY EMPTY STATE
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  section:last-of-type
  .bg-white {
    background: #191921 !important;

    border-color:
      rgba(255, 255, 255, 0.08) !important;

    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.18) !important;
  }


  /* =========================================================
     17. SUBMISSION HISTORY CARDS
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  article.bg-white {
    background: #191921 !important;

    border-color:
      rgba(255, 255, 255, 0.08) !important;

    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.18) !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  article h4 {
    color: #f8f7fb !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  article strong {
    color: #e7e4ed;
  }


  /* =========================================================
     18. SUBMISSION STATUS - SUBMITTED
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .bg-blue-100 {
    background:
      rgba(59, 130, 246, 0.12) !important;

    color:
      #93c5fd !important;

    border:
      1px solid rgba(96, 165, 250, 0.18);
  }


  /* =========================================================
     19. SUBMISSION STATUS - REVIEWED
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .bg-yellow-100 {
    background:
      rgba(234, 179, 8, 0.12) !important;

    color:
      #fde68a !important;

    border:
      1px solid rgba(250, 204, 21, 0.18);
  }


  /* =========================================================
     20. SUBMISSION STATUS - ACCEPTED
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .bg-green-100 {
    background:
      rgba(34, 197, 94, 0.12) !important;

    color:
      #86efac !important;

    border:
      1px solid rgba(74, 222, 128, 0.18);
  }


  /* =========================================================
     21. SUBMISSION STATUS - NEEDS REVISION
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .bg-red-100 {
    background:
      rgba(239, 68, 68, 0.12) !important;

    color:
      #fca5a5 !important;

    border:
      1px solid rgba(248, 113, 113, 0.18);
  }


  /* =========================================================
     22. OPEN FILE BUTTON
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  article
  a.bg-\[\#6B46C1\] {
    background: #7044d4 !important;

    color: #ffffff !important;

    border:
      1px solid rgba(167, 139, 250, 0.22);

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  article
  a.bg-\[\#6B46C1\]:hover {
    background: #7c4ce0 !important;

    box-shadow: none !important;
  }


  /* =========================================================
     23. BROWSER AUTOFILL
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  input:-webkit-autofill,

  html[data-theme="dark"]
  .academy-documents-page
  input:-webkit-autofill:hover,

  html[data-theme="dark"]
  .academy-documents-page
  input:-webkit-autofill:focus {
    -webkit-text-fill-color:
      #f8f7fb !important;

    -webkit-box-shadow:
      0 0 0 1000px #11111b inset !important;

    caret-color: #ffffff;
  }


  /* =========================================================
     24. REMOVE GLOW EFFECTS
     ========================================================= */

  html[data-theme="dark"]
  .academy-documents-page
  .shadow,

  html[data-theme="dark"]
  .academy-documents-page
  .shadow-sm,

  html[data-theme="dark"]
  .academy-documents-page
  .shadow-md {
    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.18) !important;
  }


  html[data-theme="dark"]
  .academy-documents-page
  a.shadow-sm,

  html[data-theme="dark"]
  .academy-documents-page
  a.shadow-md,

  html[data-theme="dark"]
  .academy-documents-page
  button.shadow-md {
    box-shadow: none !important;
  }


  /* =========================================================
     25. MOBILE
     ========================================================= */

  @media (max-width: 767px) {

    html[data-theme="dark"]
    .academy-documents-page
    .xl\:col-span-3.bg-white,

    html[data-theme="dark"]
    .academy-documents-page
    .xl\:col-span-2
    .bg-white,

    html[data-theme="dark"]
    .academy-documents-page
    article.bg-white,

    html[data-theme="dark"]
    .academy-documents-page
    section:last-of-type
    .bg-white {
      box-shadow:
        0 10px 22px rgba(0, 0, 0, 0.18) !important;
    }

  }
</style>
</head>
<body class="academy-documents-page bg-[#f7f7f8] text-gray-900">

  <%- include("../partials/header") %>

  <%
    const assignmentSubmissions =
      typeof submissions !== "undefined" && Array.isArray(submissions)
        ? submissions
        : [];
  %>

  <section class="bg-gradient-to-r from-[#4F46E5] via-[#7C3AED] to-[#C026D3] text-white">
    <div class="max-w-7xl mx-auto px-6 md:px-16 py-10 md:py-12">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div>
          <h1 class="text-3xl md:text-5xl font-extrabold mb-3"><%= academy.name %></h1>
          <p class="text-lg md:text-2xl text-white/90">Assignment Submission Center</p>
        </div>

        <a
          href="/academy/<%= academy.slug %>/courses"
          class="inline-flex items-center justify-center rounded-2xl bg-white text-[#4F46E5] px-8 py-4 text-lg font-semibold shadow-sm hover:shadow-md transition self-start lg:self-auto"
        >
          My Courses
        </a>
      </div>
    </div>

    <div class="border-t border-white/15">
      <div class="max-w-7xl mx-auto px-6 md:px-16">
        <div class="flex items-center gap-8 overflow-x-auto">
          <a href="/academy/<%= academy.slug %>/courses" class="inline-flex h-14 items-center border-b-2 border-transparent text-white/70 font-medium whitespace-nowrap hover:text-white transition">
            <span class="mr-2">📖</span>
            Courses
          </a>
          <a href="/academy/<%= academy.slug %>/documents" class="inline-flex h-14 items-center border-b-2 border-white text-white font-semibold whitespace-nowrap">
            <span class="mr-2">📄</span>
            Documents
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="pt-12 md:pt-14 pb-10">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <h2 class="text-4xl md:text-5xl font-extrabold text-gray-950 mb-4">
        Upload Assignment
      </h2>
      <p class="text-lg md:text-2xl text-slate-600 max-w-5xl">
        Submit your completed assignment documents for <%= academy.name %> and keep track of all your previous submissions.
      </p>
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <div class="grid grid-cols-1 xl:grid-cols-5 gap-8">

        <div class="xl:col-span-3 bg-white border border-gray-100 rounded-[28px] shadow-sm p-8 md:p-10">
          <% if (typeof submitted !== "undefined" && submitted === "success") { %>
            <div class="mb-6 rounded-2xl border border-green-200 bg-green-50 px-5 py-4 text-green-700 font-medium">
              Assignment uploaded successfully.
            </div>
          <% } %>

          <div class="mb-8">
            <h3 class="text-3xl md:text-4xl font-extrabold text-gray-950 mb-3">
              Submit New Assignment
            </h3>
            <p class="text-lg text-slate-600 leading-relaxed">
              Choose the course, add a title if needed, and upload your answer document.
            </p>
          </div>

          <form action="/academy/<%= academy.slug %>/documents/submit-assignment" method="POST" enctype="multipart/form-data" class="space-y-6">
            <div>
              <label for="courseId" class="block text-sm font-semibold text-gray-800 mb-2">Select Course</label>
              <select
                id="courseId"
                name="courseId"
                class="w-full rounded-2xl border border-gray-200 bg-white px-4 py-3.5 text-gray-900 outline-none focus:border-[#6B46C1] focus:ring-2 focus:ring-purple-100 transition"
                required
              >
                <option value="">Choose a course</option>
                <% if (courses && courses.length) { %>
                  <% courses.forEach((course) => { %>
                    <option value="<%= course._id || course.slug %>"><%= course.title %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>

            <div>
              <label for="assignmentTitle" class="block text-sm font-semibold text-gray-800 mb-2">Assignment Title</label>
              <input
                type="text"
                id="assignmentTitle"
                name="assignmentTitle"
                class="w-full rounded-2xl border border-gray-200 bg-white px-4 py-3.5 text-gray-900 outline-none focus:border-[#6B46C1] focus:ring-2 focus:ring-purple-100 transition"
                placeholder="Example: Week 1 Assignment Answers"
                required
              />
            </div>

            <div>
              <label for="submissionNote" class="block text-sm font-semibold text-gray-800 mb-2">Short Note</label>
              <textarea
                id="submissionNote"
                name="submissionNote"
                rows="4"
                class="w-full rounded-2xl border border-gray-200 bg-white px-4 py-3.5 text-gray-900 outline-none focus:border-[#6B46C1] focus:ring-2 focus:ring-purple-100 transition resize-none"
                placeholder="Add any short note for your submission..."
              ></textarea>
            </div>

            <div>
              <label for="assignmentFile" class="block text-sm font-semibold text-gray-800 mb-2">Upload Document</label>
              <input
                type="file"
                id="assignmentFile"
                name="assignmentFile"
                accept=".pdf,.doc,.docx"
                class="w-full rounded-2xl border border-gray-200 bg-white px-4 py-3.5 text-gray-900 outline-none focus:border-[#6B46C1] focus:ring-2 focus:ring-purple-100 transition"
                required
              />
              <p class="mt-2 text-sm text-slate-500">
                Accepted formats: PDF, DOC, DOCX
              </p>
            </div>

            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-full bg-[#6B46C1] text-white px-8 py-4 font-bold text-lg shadow-md hover:bg-purple-700 transition"
            >
              Upload Assignment
            </button>
          </form>
        </div>

        <div class="xl:col-span-2 space-y-8">
          <div class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-8">
            <h3 class="text-2xl md:text-3xl font-extrabold text-gray-950 mb-4">
              Submission Guide
            </h3>

            <div class="space-y-4 text-lg text-slate-700 leading-relaxed">
              <p>1. Select the course the assignment belongs to.</p>
              <p>2. Upload your completed answer document.</p>
              <p>3. Check your submission history below after upload.</p>
            </div>
          </div>

          <div class="bg-gradient-to-r from-[#4F46E5] via-[#A855F7] to-[#EC4899] rounded-[28px] p-8 text-white shadow-sm">
            <h3 class="text-2xl md:text-3xl font-extrabold mb-4">
              Keep Your Work Organized
            </h3>
            <p class="text-lg leading-relaxed text-white/95">
              Every submitted assignment in <%= academy.name %> will appear in your history, making it easy to track what you have already turned in.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="pb-20 md:pb-24">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <div class="mb-8">
        <h3 class="text-3xl md:text-4xl font-extrabold text-gray-950 mb-3">
          Submission History
        </h3>
        <p class="text-lg text-slate-600">
          View your previously uploaded assignment documents here.
        </p>
      </div>

      <% if (!assignmentSubmissions.length) { %>
        <div class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-10 text-center">
          <h4 class="text-2xl font-extrabold text-gray-950 mb-3">
            No submissions yet
          </h4>
          <p class="text-lg text-slate-600">
            Your uploaded assignment documents will appear here after submission.
          </p>
        </div>
      <% } else { %>
        <div class="space-y-6">
          <% assignmentSubmissions.forEach((item) => { %>
            <article class="bg-white border border-gray-100 rounded-[28px] shadow-sm p-8">
              <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
                <div>
                  <h4 class="text-2xl font-extrabold text-gray-950 mb-2">
                    <%= item.assignmentTitle %>
                  </h4>
                  <p class="text-lg text-slate-700 mb-2">
                    <strong>Course:</strong> <%= item.courseTitle %>
                  </p>

                  <div class="mb-2">
                    <span class="font-semibold text-slate-700">Status:</span>
                    <span class="inline-flex rounded-full px-3 py-1 text-sm font-semibold
                      <%= item.status === 'Submitted' ? 'bg-blue-100 text-blue-700' : '' %>
                      <%= item.status === 'Reviewed' ? 'bg-yellow-100 text-yellow-700' : '' %>
                      <%= item.status === 'Accepted' ? 'bg-green-100 text-green-700' : '' %>
                      <%= item.status === 'Needs Revision' ? 'bg-red-100 text-red-700' : '' %>
                    ">
                      <%= item.status || "Submitted" %>
                    </span>
                  </div>

                  <p class="text-lg text-slate-700 mb-2">
                    <strong>Submitted:</strong> <%= item.submittedAt %>
                  </p>

                  <% if (item.submissionNote) { %>
                    <p class="text-base text-slate-600 mt-4">
                      <strong>Note:</strong> <%= item.submissionNote %>
                    </p>
                  <% } %>
                </div>

                <div class="flex flex-wrap gap-3">
                  <a
                    href="<%= item.fileUrl %>"
                    target="_blank"
                    class="inline-flex items-center justify-center rounded-2xl bg-[#6B46C1] text-white px-6 py-3 font-semibold hover:bg-purple-700 transition"
                  >
                    Open File
                  </a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <%- include("../partials/footer") %>
</body>
</html>