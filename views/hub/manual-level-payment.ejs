<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manual Payment | <%= academy.name %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
  /* =========================================================
     ACADEMY MANUAL PAYMENT PAGE - DARK MODE
     =========================================================
     Covers:
     - Page canvas
     - Back link
     - Bank details card
     - Payment reference
     - Verification form
     - Text fields
     - File upload
     - Submit button

     Light mode remains unchanged.
     No glow effects.
     ========================================================= */


  /* =========================================================
     1. PAGE CANVAS
     ========================================================= */

  html[data-theme="dark"]
  body.academy-manual-payment-page {
    background: #0f0f18 !important;
    color: #d7d4df;
  }


  /* =========================================================
     2. BACK TO COURSES LINK
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  a[href*="/courses"] {
    color: #a78bfa !important;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  a[href*="/courses"]:hover {
    color: #c4b5fd !important;
  }


  /* =========================================================
     3. MAIN CARDS
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  .xl\:col-span-2.bg-white,

  html[data-theme="dark"]
  .academy-manual-payment-page
  .xl\:col-span-3.bg-white {
    background: #191921 !important;

    border-color:
      rgba(255, 255, 255, 0.08) !important;

    box-shadow:
      0 14px 30px rgba(0, 0, 0, 0.20) !important;
  }


  /* =========================================================
     4. HEADINGS
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  .text-gray-950 {
    color: #f8f7fb !important;
  }


  /* =========================================================
     5. BODY TEXT
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  .text-slate-700 {
    color: #c9c6d1 !important;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  .text-slate-600 {
    color: #aaa6b4 !important;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  .text-slate-500 {
    color: #8f8b99 !important;
  }


  /* Bank detail labels */

  html[data-theme="dark"]
  .academy-manual-payment-page
  strong {
    color: #f1eef6;
  }


  /* =========================================================
     6. PAYMENT REFERENCE BOX
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  .bg-purple-50 {
    background:
      rgba(139, 92, 246, 0.10) !important;

    border-color:
      rgba(139, 92, 246, 0.20) !important;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  .bg-purple-50
  .text-slate-600 {
    color: #aaa6b4 !important;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  .bg-purple-50
  .text-\[\#6B46C1\] {
    color: #a78bfa !important;
  }


  /* =========================================================
     7. FORM LABELS
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  form label {
    color: #e7e4ed !important;
  }


  /* =========================================================
     8. FORM INPUTS / TEXTAREA
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  form input,

  html[data-theme="dark"]
  .academy-manual-payment-page
  form textarea {
    background: #11111b !important;

    color: #f8f7fb !important;

    border-color:
      rgba(255, 255, 255, 0.11) !important;

    outline: none;

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  form input::placeholder,

  html[data-theme="dark"]
  .academy-manual-payment-page
  form textarea::placeholder {
    color: #777482 !important;
  }


  /* =========================================================
     9. FORM FOCUS
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  form input:focus,

  html[data-theme="dark"]
  .academy-manual-payment-page
  form textarea:focus {
    border-color:
      #8b5cf6 !important;

    outline: none !important;

    box-shadow:
      0 0 0 2px rgba(139, 92, 246, 0.10) !important;
  }


  /* =========================================================
     10. FILE UPLOAD FIELD
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  input[type="file"] {
    background: #11111b !important;

    color: #c9c6d1 !important;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  input[type="file"]::file-selector-button {
    border: none;

    border-radius: 0.75rem;

    background: #7044d4;

    color: #ffffff;

    padding:
      0.65rem 1rem;

    margin-right:
      1rem;

    font-weight: 600;

    cursor: pointer;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  input[type="file"]::file-selector-button:hover {
    background: #7c4ce0;
  }


  /* =========================================================
     11. SUBMIT PAYMENT BUTTON
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  form button[type="submit"] {
    background: #7044d4 !important;

    color: #ffffff !important;

    border:
      1px solid rgba(167, 139, 250, 0.22);

    box-shadow: none !important;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  form button[type="submit"]:hover {
    background: #7c4ce0 !important;

    color: #ffffff !important;

    box-shadow: none !important;
  }


  /* =========================================================
     12. BROWSER AUTOFILL
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  input:-webkit-autofill,

  html[data-theme="dark"]
  .academy-manual-payment-page
  input:-webkit-autofill:hover,

  html[data-theme="dark"]
  .academy-manual-payment-page
  input:-webkit-autofill:focus {
    -webkit-text-fill-color:
      #f8f7fb !important;

    -webkit-box-shadow:
      0 0 0 1000px #11111b inset !important;

    caret-color: #ffffff;
  }


  /* =========================================================
     13. REMOVE GLOW / LIGHT SHADOWS
     ========================================================= */

  html[data-theme="dark"]
  .academy-manual-payment-page
  .shadow,

  html[data-theme="dark"]
  .academy-manual-payment-page
  .shadow-sm,

  html[data-theme="dark"]
  .academy-manual-payment-page
  .shadow-md {
    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.18) !important;
  }


  html[data-theme="dark"]
  .academy-manual-payment-page
  button.shadow-sm,

  html[data-theme="dark"]
  .academy-manual-payment-page
  button.shadow-md,

  html[data-theme="dark"]
  .academy-manual-payment-page
  a.shadow-sm,

  html[data-theme="dark"]
  .academy-manual-payment-page
  a.shadow-md {
    box-shadow: none !important;
  }


  /* =========================================================
     14. MOBILE
     ========================================================= */

  @media (max-width: 767px) {

    html[data-theme="dark"]
    .academy-manual-payment-page
    .xl\:col-span-2.bg-white,

    html[data-theme="dark"]
    .academy-manual-payment-page
    .xl\:col-span-3.bg-white {
      box-shadow:
        0 10px 22px rgba(0, 0, 0, 0.18) !important;
    }

  }
</style>
</head>
<body class="bg-[#f7f7f8] text-gray-900">

  <%- include("../partials/header") %>

  <section class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <div class="mb-8">
        <a href="/academy/<%= academy.slug %>/courses" class="text-[#6B46C1] font-semibold hover:underline">
          ← Back to <%= academy.name %> Courses
        </a>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-5 gap-8">

        <div class="xl:col-span-2 bg-white border border-gray-100 rounded-[28px] shadow-sm p-8">
          <h1 class="text-3xl md:text-4xl font-extrabold text-gray-950 mb-4">
            Manual Payment
          </h1>

          <p class="text-lg text-slate-700 mb-6">
            Complete payment for <strong><%= level.title %></strong> in <strong><%= academy.name %></strong> using the bank details below.
          </p>

          <div class="space-y-4 text-base md:text-lg text-slate-700">
            <p><strong>Bank Name:</strong> <%= bankName %></p>
            <p><strong>Account Name:</strong> <%= accountName %></p>
            <p><strong>Account Number:</strong> <%= accountNumber %></p>
            <p><strong>Display Price:</strong> <%= level.price || "Not set" %></p>
            <p><strong>Transfer Amount (Naira):</strong> <%= level.priceNaira ? `₦${Number(level.priceNaira).toLocaleString()}` : "Not set" %></p>
          </div>

          <div class="mt-8 rounded-2xl bg-purple-50 border border-purple-100 p-5">
            <p class="text-sm font-semibold text-slate-600 mb-2">USE THIS REFERENCE</p>
            <p class="text-xl md:text-2xl font-extrabold text-[#6B46C1] break-all">
              <%= paymentRequest.reference %>
            </p>
          </div>
        </div>

        <div class="xl:col-span-3 bg-white border border-gray-100 rounded-[28px] shadow-sm p-8 md:p-10">
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-950 mb-4">
            You have paid?
          </h2>

          <p class="text-lg text-slate-600 mb-8">
            After making the transfer, submit the details below for admin verification.
          </p>

          <form action="/academy/<%= academy.slug %>/manual-payment/levels/<%= level._id %>/submit" method="POST" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" name="requestId" value="<%= paymentRequest._id %>">

            <div>
              <label class="block text-sm font-semibold mb-2">Payer Name</label>
              <input name="payerName" type="text" class="w-full rounded-2xl border border-gray-200 px-4 py-3.5" required>
            </div>

            <div class="grid grid-cols-1 gap-6">
              <div>
                <label class="block text-sm font-semibold mb-2">Bank Transaction Reference / Session ID</label>
                <input
                  name="transactionNumber"
                  type="text"
                  class="w-full rounded-2xl border border-gray-200 px-4 py-3.5"
                  placeholder="Enter the transfer reference from your bank app or alert"
                  required
                >
                <p class="mt-2 text-sm text-slate-500">
                  This is the transaction reference, session ID, or transfer code from your bank transaction.
                </p>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold mb-2">Short Note</label>
              <textarea name="note" rows="4" class="w-full rounded-2xl border border-gray-200 px-4 py-3.5"></textarea>
            </div>

            <div>
              <label class="block text-sm font-semibold mb-2">Upload Proof (Optional)</label>
              <input name="proofFile" type="file" accept=".jpg,.jpeg,.png,.pdf" class="w-full rounded-2xl border border-gray-200 px-4 py-3.5">
            </div>

            <button type="submit" class="rounded-2xl bg-[#6B46C1] text-white px-8 py-4 font-semibold hover:bg-purple-700 transition">
              Submit Payment Request
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <%- include("../partials/footer") %>
</body>
</html>